
@model IEnumerable<web_sport_gear.Models.Category>

@foreach (var category in Model)
{
    string actionName = "";
    string controllerName = "";

    // Giữ nguyên đường dẫn của 3 danh mục cũ
    switch (category.CategoryID)
    {
        case 1:
            actionName = "AOTHETHAO";
            controllerName = "Product";
            break;

        case 2:
            actionName = "PHUKIEN";
            controllerName = "Product";
            break;

        case 3:
            actionName = "GiayDaBong";
            controllerName = "Product";
            break;

        // Các danh mục mới sử dụng trang động
        default:
            actionName = "Category";
            controllerName = "Home";
            break;
    }

    <li>
        <a href="@Url.Action(
            actionName,
            controllerName,
            new { id = category.CategoryID, area = "" })">
            @category.CategoryName
        </a>
    </li>
}
