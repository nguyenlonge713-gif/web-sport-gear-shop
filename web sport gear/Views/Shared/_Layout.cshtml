
@{
    // Kiểm tra trạng thái đăng nhập
    bool isLoggedIn = Session["UserID"] != null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Gear Sport - Website Bán Đồ Thể Thao</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap"
          rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CSS hiện có -->
    <link href="@Url.Content("~/Content/style.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            color: #111111;
        }

        /* ==================== HEADER ==================== */
        header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 22px;
            padding: 15px 40px;
            background-color: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            header > .logo {
                font-size: 22px;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: #0f172a;
                text-decoration: none;
                white-space: nowrap;
                flex-shrink: 0;
            }

        /* ==================== THANH TÌM KIẾM ==================== */
        .header-search {
            display: flex;
            align-items: center;
            width: 360px;
            max-width: 100%;
            height: 48px;
            flex: 0 1 360px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            background-color: #f8fafc;
            overflow: hidden;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .header-search:focus-within {
                border-color: #ff5722;
                box-shadow: 0 0 0 3px rgba(255, 87, 34, 0.12);
            }

            .header-search input {
                flex: 1;
                min-width: 0;
                width: 100%;
                height: 100%;
                padding: 0 16px;
                font-family: 'Montserrat', sans-serif;
                font-size: 15px;
                color: #0f172a;
                background: transparent;
                border: none;
                outline: none;
            }

                .header-search input::placeholder {
                    color: #94a3b8;
                }

            .header-search button {
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                width: 54px;
                height: 100%;
                padding: 0;
                font-size: 19px;
                color: #ffffff;
                background-color: #ff5722;
                border: none;
                cursor: pointer;
                transition: background-color 0.2s ease;
            }

                .header-search button:hover {
                    background-color: #e64a19;
                }

        /* ==================== MENU DANH MỤC ==================== */
        .main-menu {
            flex: 1 1 auto;
            display: flex;
            justify-content: center;
            min-width: 0;
        }

            .main-menu ul {
                display: flex;
                align-items: center;
                list-style: none;
                margin: 0;
                padding: 0;
                gap: 25px;
            }

                .main-menu ul li a {
                    text-decoration: none;
                    color: #334155;
                    font-weight: 700;
                    font-size: 13px;
                    text-transform: uppercase;
                    letter-spacing: 0.3px;
                    white-space: nowrap;
                    transition: color 0.2s ease;
                }

                    .main-menu ul li a:hover {
                        color: #ff5722;
                    }

        /* ==================== TÀI KHOẢN VÀ GIỎ HÀNG ==================== */
        .header-actions {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-shrink: 0;
        }

        /* NÚT ĐĂNG NHẬP */
        .header-login-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 6px;
            background-color: #ff5722;
            color: #fff !important;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none !important;
            text-transform: uppercase;
            white-space: nowrap;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

            .header-login-btn:hover {
                background-color: #e64a19;
                transform: translateY(-2px);
            }

        /* ==================== MENU TÀI KHOẢN ==================== */
        .account-dropdown {
            position: relative;
        }

        .header-user {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px;
            border: none;
            border-radius: 6px;
            background: transparent;
            color: #0f172a;
            font-family: 'Montserrat', sans-serif;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .header-user:hover {
                background-color: #f1f5f9;
            }

            .header-user:focus {
                outline: 2px solid #ff5722;
                outline-offset: 2px;
            }

            .header-user > i:first-child {
                font-size: 17px;
                color: #ff5722;
            }

        .header-user-name {
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .account-arrow {
            font-size: 11px !important;
            color: #64748b !important;
            transition: transform 0.2s ease;
        }

        .account-dropdown.is-open .account-arrow {
            transform: rotate(180deg);
        }

        /* ==================== KHUNG MENU TÀI KHOẢN ==================== */
        .account-menu {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 260px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            padding: 8px;
            z-index: 2000;
        }

            .account-menu[hidden] {
                display: none !important;
            }

            .account-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px;
                color: #334155;
                text-decoration: none;
                font-size: 13px;
                font-weight: 600;
                border-radius: 6px;
                transition: background-color 0.2s ease, color 0.2s ease;
            }

                .account-menu a i {
                    width: 18px;
                    color: #ff5722;
                    text-align: center;
                }

                .account-menu a:hover {
                    background-color: #fff1eb;
                    color: #ff5722;
                }

        .account-menu-divider {
            height: 1px;
            background: #e5e7eb;
            margin: 6px 0;
        }

        .account-role {
            padding: 8px 12px;
            font-size: 11px;
            color: #64748b;
            font-weight: 600;
        }

        /* ==================== ĐĂNG XUẤT ==================== */
        .logout-form {
            display: block;
            width: 100%;
            margin: 0;
        }

        .header-logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 11px 14px;
            border: none;
            border-radius: 6px;
            background-color: #0f172a;
            color: #ffffff;
            font-family: 'Montserrat', sans-serif;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: background-color 0.2s ease;
        }

            .header-logout-btn:hover {
                background-color: #334155;
            }

        /* ==================== GIỎ HÀNG ==================== */
        .cart a {
            position: relative;
            color: #0f172a;
            font-size: 21px;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .cart-count {
            position: absolute;
            top: -8px;
            right: -10px;
            background-color: #ff5722;
            color: white;
            font-size: 10px;
            font-weight: bold;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ==================== FOOTER ==================== */
        footer {
            background-color: #0f172a;
            color: #94a3b8;
            text-align: center;
            padding: 40px 20px;
            margin-top: 60px;
            font-size: 14px;
        }

            footer p {
                margin: 0;
            }

        /* ==================== TABLET ==================== */
        @@media (max-width: 1100px) {
            header {
                padding: 15px 24px;
                gap: 16px;
            }

            .header-search {
                width: 320px;
                flex-basis: 320px;
            }

            .main-menu ul {
                gap: 16px;
            }

                .main-menu ul li a {
                    font-size: 12px;
                }

            .header-user-name {
                max-width: 140px;
            }
        }

        /* ==================== ĐIỆN THOẠI ==================== */
        @@media (max-width: 768px) {
            header {
                padding: 14px 20px;
                flex-direction: column;
                gap: 14px;
            }

                header > .logo {
                    font-size: 23px;
                }

            .header-search {
                width: 100%;
                max-width: 480px;
                flex: 0 1 48px;
                height: 48px;
            }

                .header-search input {
                    font-size: 15px;
                }

            .main-menu {
                width: 100%;
                justify-content: center;
            }

                .main-menu ul {
                    flex-wrap: wrap;
                    justify-content: center;
                    gap: 14px 18px;
                }

                    .main-menu ul li a {
                        font-size: 11px;
                    }

            .header-actions {
                justify-content: center;
                flex-wrap: wrap;
                gap: 12px;
            }

            .header-user-name {
                max-width: 180px;
            }
        }

        /* ==================== ĐIỆN THOẠI NHỎ ==================== */
        @@media (max-width: 400px) {
            .main-menu ul {
                gap: 12px;
            }

            .header-search input {
                padding: 0 12px;
                font-size: 14px;
            }

            .header-actions {
                gap: 10px;
            }

            .header-user {
                font-size: 12px;
            }

            .header-user-name {
                max-width: 130px;
            }

            .header-logout-btn {
                padding: 9px 10px;
                font-size: 11px;
            }

            .account-menu {
                right: 50%;
                transform: translateX(50%);
                max-width: calc(100vw - 30px);
            }
        }
    </style>
</head>

<body>

    <!-- ==================== HEADER GEAR SPORT ==================== -->
    <header>

        <!-- LOGO -->
        <a href="@Url.Action("Index", "Home", new { area = "" })"
           class="logo">
            Gear Sport
        </a>

        <!-- THANH TÌM KIẾM SẢN PHẨM -->
        <form action="@Url.Action("Search", "Home", new { area = "" })"
              method="get"
              class="header-search">

            <input type="search"
                   name="q"
                   placeholder="Tìm sản phẩm..."
                   value="@(Request.QueryString["q"])"
                   aria-label="Tìm kiếm sản phẩm" />

            <button type="submit" aria-label="Tìm kiếm">
                <i class="fas fa-search"></i>
            </button>
        </form>

        <!-- MENU DANH MỤC LẤY TỪ SQL SERVER -->
        <nav class="main-menu">
            <ul>
                <li>
                    <a href="@Url.Action("Index", "Home", new { area = "" })">
                        Trang Chủ
                    </a>
                </li>

                @Html.Action(
                         "MenuCategories",
                         "Home",
                         new { area = "" }
                     )
            </ul>
        </nav>

        <!-- ==================== TÀI KHOẢN VÀ GIỎ HÀNG ==================== -->
        <div class="header-actions">

            @if (isLoggedIn)
            {
                <div class="account-dropdown" id="accountDropdown">

                    <!-- NÚT MỞ MENU -->
                    <button type="button"
                            class="header-user"
                            id="accountToggle"
                            aria-expanded="false"
                            aria-controls="accountMenu">

                        <i class="fa-regular fa-user"></i>

                        <span class="header-user-name">
                            Xin chào, @(Session["FullName"] ?? "Khách hàng")
                        </span>

                        <i class="fa-solid fa-chevron-down account-arrow"></i>
                    </button>

                    <!-- MENU TÀI KHOẢN -->
                    <div class="account-menu"
                         id="accountMenu"
                         hidden>

                        <a href="@Url.Action("Profile", "Account", new { area = "" })">
                            <i class="fa-regular fa-id-card"></i>
                            Hồ sơ của tôi
                        </a>

                        <a href="@Url.Action("OrderHistory", "Account", new { area = "" })">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            Lịch sử mua hàng
                        </a>

                        <a href="@Url.Action("ChangePassword", "Account", new { area = "" })">
                            <i class="fa-solid fa-lock"></i>
                            Đổi mật khẩu
                        </a>

                        <div class="account-menu-divider"></div>

                        <!-- THÔNG TIN VAI TRÒ -->
                        <div class="account-role">
                            Vai trò: @(Session["Role"] ?? "Khách hàng")
                        </div>

                        <div class="account-menu-divider"></div>

                        <!-- FORM ĐĂNG XUẤT -->
                        @using (Html.BeginForm(
                            "Logout",
                            "Account",
                            new { area = "" },
                            FormMethod.Post,
                            new { @class = "logout-form" }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit" class="header-logout-btn">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                Đăng xuất
                            </button>
                        }

                    </div>
                </div>
            }
            else
            {
                <!-- HIỂN THỊ KHI CHƯA ĐĂNG NHẬP -->
                <a href="@Url.Action("Login", "Account", new { area = "" })"
                   class="header-login-btn">

                    <i class="fa-regular fa-user"></i>
                    <span>Đăng nhập</span>
                </a>
            }

            <!-- GIỎ HÀNG -->
            <div class="cart">
                <a href="@Url.Action("Cart", "Home", new { area = "" })"
                   aria-label="Giỏ hàng">

                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count">0</span>
                </a>
            </div>

        </div>
    </header>

    <!-- ==================== NỘI DUNG TRANG ==================== -->
    <main>
        @RenderBody()
    </main>

    <!-- ==================== FOOTER ==================== -->
    <footer>
        <p>&copy; 2026 - Gear Sport Store. All rights reserved.</p>
    </footer>

    <!-- ==================== JAVASCRIPT ==================== -->
    <script>
       window.isUserLoggedIn = @(isLoggedIn ? "true" : "false");
window.currentUserId = '@(isLoggedIn ? Session["UserID"].ToString() : "")';
window.currentUserRole = '@(Session["Role"] ?? "")';
window.loginUrl = '@Url.Action("Login", "Account", new { area = "" })';

        // XỬ LÝ MENU TÀI KHOẢN
        document.addEventListener("DOMContentLoaded", function () {

            var dropdown = document.getElementById("accountDropdown");
            var toggle = document.getElementById("accountToggle");
            var menu = document.getElementById("accountMenu");

            if (!dropdown || !toggle || !menu) {
                return;
            }

            // MỞ / ĐÓNG MENU
            toggle.addEventListener("click", function (event) {

                event.stopPropagation();

                var isOpening = menu.hidden;

                menu.hidden = !isOpening;

                toggle.setAttribute(
                    "aria-expanded",
                    isOpening ? "true" : "false"
                );

                dropdown.classList.toggle("is-open", isOpening);
            });

            // ĐÓNG MENU KHI NHẤN RA NGOÀI
            document.addEventListener("click", function (event) {

                if (!dropdown.contains(event.target)) {

                    menu.hidden = true;

                    toggle.setAttribute("aria-expanded", "false");

                    dropdown.classList.remove("is-open");
                }
            });

            // ĐÓNG MENU BẰNG PHÍM ESC
            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {

                    menu.hidden = true;

                    toggle.setAttribute("aria-expanded", "false");

                    dropdown.classList.remove("is-open");
                }
            });

        });
    </script>

    <script src="@Url.Content("~/Scripts/main.js")"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
