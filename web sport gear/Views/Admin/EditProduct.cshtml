
@model web_sport_gear.Models.Product

@{
    ViewBag.Title = "Sửa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="padding: 35px 0; max-width: 850px;">

    <h2>SỬA THÔNG TIN SẢN PHẨM</h2>

    <p>Cập nhật thông tin sản phẩm trong hệ thống Gear Sport.</p>

    <hr />

    @using (Html.BeginForm("EditProduct", "Admin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.ProductID)

        <div class="form-group">
            <label>Tên sản phẩm</label>
            @Html.TextBoxFor(m => m.ProductName, new
            {
                @class = "form-control"
            })
            @Html.ValidationMessageFor(m => m.ProductName, "", new
            {
                @class = "text-danger"
            })
        </div>

        <div class="form-group">
            <label>Giá sản phẩm (VNĐ)</label>
            @Html.TextBoxFor(m => m.Price, new
            {
                @class = "form-control",
                type = "number",
                min = "1",
                step = "0.01"
            })
            @Html.ValidationMessageFor(m => m.Price, "", new
            {
                @class = "text-danger"
            })
        </div>

        <div class="form-group">
            <label>Danh mục</label>
            @Html.DropDownListFor(
                m => m.CategoryID,
                (IEnumerable<SelectListItem>)ViewBag.Categories,
                "-- Chọn danh mục --",
                new { @class = "form-control" }
            )
            @Html.ValidationMessageFor(m => m.CategoryID, "", new
            {
                @class = "text-danger"
            })
        </div>

        <div class="form-group">
            <label>URL hình ảnh</label>
            @Html.TextBoxFor(m => m.ImageUrl, new
            {
                @class = "form-control",
                placeholder = "Nhập URL hình ảnh..."
            })
        </div>

        <div class="form-group">
            <label>Mô tả sản phẩm</label>
            @Html.TextAreaFor(m => m.Description, new
            {
                @class = "form-control",
                rows = "4"
            })
        </div>

        <div class="checkbox">
            <label>
                @Html.CheckBoxFor(m => m.IsActive)
                Hiển thị sản phẩm trên website
            </label>
        </div>

        <hr />

        <button type="submit" class="btn btn-primary">
            Lưu thay đổi
        </button>

        <a href="@Url.Action("ProductList", "Admin")"
           class="btn btn-default">
            Hủy
        </a>
    }
</div>
