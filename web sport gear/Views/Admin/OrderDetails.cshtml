
@model web_sport_gear.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4">CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h2>

    <div class="card mb-4">
        <div class="card-header">
            <strong>Thông tin đơn hàng</strong>
        </div>
        <div class="card-body">
            <p><strong>Khách hàng:</strong> @ViewBag.CustomerName</p>
            <p><strong>Người nhận:</strong> @Model.ReceiverName</p>
            <p><strong>Số điện thoại:</strong> @Model.ReceiverPhone</p>
            <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
            <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
            <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>

            <p>
                <strong>Trạng thái đơn hàng:</strong>
                @Model.OrderStatus
            </p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <hr />

            <h5>Cập nhật trạng thái đơn hàng</h5>

            @using (Html.BeginForm("UpdateOrderStatus", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="orderId" value="@Model.OrderID" />

                <div class="form-group mb-3">
                    <select name="orderStatus" class="form-control">
                        <option value="Chờ xác nhận"
                                @(Model.OrderStatus == "Chờ xác nhận" ? "selected" : "")>
                            Chờ xác nhận
                        </option>

                        <option value="Đang xử lý"
                                @(Model.OrderStatus == "Đang xử lý" ? "selected" : "")>
                            Đang xử lý
                        </option>

                        <option value="Đang giao"
                                @(Model.OrderStatus == "Đang giao" ? "selected" : "")>
                            Đang giao
                        </option>

                        <option value="Đã giao"
                                @(Model.OrderStatus == "Đã giao" ? "selected" : "")>
                            Đã giao
                        </option>

                        <option value="Đã hủy"
                                @(Model.OrderStatus == "Đã hủy" ? "selected" : "")>
                            Đã hủy
                        </option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Cập nhật trạng thái
                </button>
            }

            <p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(Model.Note) ? "Không có" : Model.Note)</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <strong>Danh sách sản phẩm</strong>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã sản phẩm</th>
                            <th>Tên sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>@item.ProductID</td>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0") đ</td>
                                <td>@item.SubTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h4 class="text-end mt-3">
                Tổng tiền: <strong>@Model.TotalAmount.ToString("N0") đ</strong>
            </h4>
        </div>
    </div>

    <a href="@Url.Action("OrderList", "Admin")"
       class="btn btn-secondary">
        Quay lại danh sách đơn hàng
    </a>
</div>
