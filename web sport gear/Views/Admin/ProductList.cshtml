
@model IEnumerable<web_sport_gear.Models.Product>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="padding: 35px 0;">

    <h2>QUẢN LÝ SẢN PHẨM</h2>

    <p>Danh sách sản phẩm trong hệ thống Gear Sport.</p>

    <hr />

    <!-- Thông báo thành công -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Thông báo lỗi -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Khu vực nút chức năng -->
    <div style="margin-bottom: 20px;">

        <!-- Thêm sản phẩm -->
        <a href="@Url.Action("CreateProduct", "Products", new { area = "Admin" })"
           class="btn btn-success">

            <i class="glyphicon glyphicon-plus"></i>
            Thêm sản phẩm

        </a>

        <!-- Quay lại Dashboard -->
        <a href="@Url.Action("Index", "Admin", new { area = "Admin" })"
           class="btn btn-default">

            Quay lại Dashboard

        </a>

    </div>

    <!-- Bảng danh sách sản phẩm -->
    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Mã SP</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th>Tồn kho</th>
                <th>Trạng thái</th>
                <th style="min-width: 230px;">Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <!-- Mã sản phẩm -->
                    <td>@item.ProductID</td>

                    <!-- Hình ảnh -->
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="@item.ProductName"
                                 style="width: 65px; height: 65px; object-fit: cover;" />
                        }
                        else
                        {
                            <span>Chưa có ảnh</span>
                        }
                    </td>

                    <!-- Tên sản phẩm -->
                    <td>@item.ProductName</td>

                    <!-- Danh mục -->
                    <td>@item.CategoryName</td>

                    <!-- Giá -->
                    <td>@item.Price.ToString("N0") đ</td>

                    <!-- Tồn kho -->
                    <td>
                        @if (item.StockQuantity > 0)
                        {
                            <span class="label label-success">
                                @item.StockQuantity
                            </span>
                        }
                        else
                        {
                            <span class="label label-danger">
                                Hết hàng
                            </span>
                        }
                    </td>

                    <!-- Trạng thái -->
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="label label-success">
                                Đang hiển thị
                            </span>
                        }
                        else
                        {
                            <span class="label label-default">
                                Đã ẩn
                            </span>
                        }
                    </td>

                    <!-- Các chức năng -->
                    <td>

                        <!-- Sửa sản phẩm -->
                        <a href="@Url.Action("EditProduct", "Products",
                            new { area = "Admin", id = item.ProductID })"
                           class="btn btn-primary btn-sm"
                           style="margin-bottom: 5px;">

                            <i class="glyphicon glyphicon-edit"></i>
                            Sửa

                        </a>

                        <!-- Ẩn / Hiện sản phẩm -->
                        @using (Html.BeginForm(
                            "ToggleProductStatus",
                            "Products",
                            new { area = "Admin", id = item.ProductID },
                            FormMethod.Post,
                            new { style = "display:inline-block; margin-bottom: 5px;" }))
                        {
                            @Html.AntiForgeryToken()

                            if (item.IsActive)
                            {
                                <button type="submit"
                                        class="btn btn-warning btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn ẩn sản phẩm này?');">

                                    <i class="glyphicon glyphicon-eye-close"></i>
                                    Ẩn

                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn btn-success btn-sm"
                                        onclick="return confirm('Bạn có chắc muốn hiện sản phẩm này?');">

                                    <i class="glyphicon glyphicon-eye-open"></i>
                                    Hiện

                                </button>
                            }
                        }

                        

                    </td>

                </tr>
            }

        </tbody>

    </table>

    <!-- Tổng số sản phẩm -->
    <p>
        Tổng số sản phẩm:
        <strong>@Model.Count()</strong>
    </p>

</div>
