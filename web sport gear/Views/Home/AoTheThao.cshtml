@{
    ViewBag.Title = "Áo Thể Thao - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================
       GEAR SPORT - ADIDAS/PUMA CAMPAIGN STYLE
       ========================================== */

    /* 1. Hero Campaign Banner Tràn Viền Cực Đại */
    .adidas-hero-campaign {
        position: relative;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        height: 480px;
        background: #0f172a;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
    }

        .adidas-hero-campaign img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            opacity: 0.85;
        }

    .adidas-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
    }

    .adidas-hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: #ffffff;
        padding: 0 20px;
        max-width: 900px;
    }

    .adidas-breadcrumb {
        font-size: 12px;
        letter-spacing: 1px;
        color: #cbd5e1;
        text-transform: uppercase;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .adidas-hero-title {
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 900;
        text-transform: uppercase;
        margin: 0 0 12px 0;
        letter-spacing: -1px;
    }

    .adidas-hero-desc {
        font-size: 15px;
        color: #e2e8f0;
        margin: 0;
        font-weight: 400;
        letter-spacing: 0.5px;
    }

    /* 2. Dải danh mục phụ dạng thẻ ảnh thu nhỏ (Sub-category Cards) */
    .sub-categories-bar {
        max-width: 1300px;
        margin: 0 auto 40px auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    .sub-cat-card {
        position: relative;
        height: 90px;
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e293b;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

        .sub-cat-card img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.5;
            transition: transform 0.4s ease;
        }

        .sub-cat-card:hover img {
            transform: scale(1.08);
            opacity: 0.7;
        }

        .sub-cat-card span {
            position: relative;
            z-index: 2;
            color: #ffffff;
            font-weight: 800;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.6);
        }

        .sub-cat-card.active, .sub-cat-card:hover {
            border-color: #ff5722;
        }

    /* 3. Bố cục chính Full-width không có sidebar bên trái */
    .adidas-catalog-container {
        max-width: 1300px;
        margin: 0 auto 60px auto;
        padding: 0 20px;
    }

    .adidas-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 15px;
    }

    .adidas-count {
        font-size: 14px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .adidas-sort select {
        padding: 8px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-weight: 600;
        font-size: 14px;
        outline: none;
        background: #fff;
        cursor: pointer;
    }

    /* Tùy chỉnh lưới sản phẩm rộng rãi */
    .adidas-catalog-container .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }
</style>

<!-- 1. HERO CAMPAIGN BANNER TRÀN VIỀN -->
<div class="adidas-hero-campaign">
    <img src="https://images.unsplash.com/photo-1637666532931-b835a227b955?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" alt="Áo Thể Thao Campaign" />
    <div class="adidas-hero-overlay"></div>
    <div class="adidas-hero-content">
        <div class="adidas-breadcrumb">Trang chủ / Áo Thể Thao</div>
        <h1 class="adidas-hero-title">Bộ Sưu Tập Áo Thể Thao</h1>
        <p class="adidas-hero-desc">Đột phá phong cách và tối ưu hiệu suất vận động với các thiết kế công nghệ cao cấp.</p>
    </div>
</div>

<!-- 2. THANH CHUYỂN NHANH DANH MỤC PHỤ (SUB-CATEGORIES CARDS) -->
<div class="sub-categories-bar">
    <a href="#" class="sub-cat-card active">
        <img src="https://images.unsplash.com/photo-1581655353564-df123a1eb820?w=400" alt="Tất cả áo" />
        <span>Tất cả áo</span>
    </a>
    <a href="#" class="sub-cat-card">
        <img src="https://images.unsplash.com/photo-1581655353564-df123a1eb820?w=400" alt="Áo thun" />
        <span>Áo Thun Thể Thao</span>
    </a>
    <a href="#" class="sub-cat-card">
        <img src="https://images.unsplash.com/photo-1611308725032-74f0a551d018?w=400" alt="Áo khoác gió" />
        <span>Áo Khoác Gió</span>
    </a>
    <a href="#" class="sub-cat-card">
        <img src="https://plus.unsplash.com/premium_photo-1747861981617-1512bc2c06e8?w=400" alt="Áo polo" />
        <span>Áo Polo Thể Thao</span>
    </a>
</div>

<!-- 3. KHU VỰC HIỂN THỊ SẢN PHẨM CHÍNH -->
<div class="adidas-catalog-container">
    <div class="adidas-toolbar">
        <span class="adidas-count">Hiển thị 3 sản phẩm chính hãng</span>
        <div class="adidas-sort">
            <select>
                <option>Sắp xếp: Mới nhất</option>
                <option>Giá: Thấp đến cao</option>
                <option>Giá: Cao xuống thấp</option>
            </select>
        </div>
    </div>

    <section class="featured-products">
        <div class="product-container product-grid">

            <div class="product-item product-card">
                <img src="https://images.unsplash.com/photo-1581655353564-df123a1eb820" alt="Áo thun thể thao" class="product-img" />
                <div class="product-info">
                    <h3 class="product-title">Áo Thun Thể Thao Nam</h3>
                    <p class="product-price">350.000 đ</p>
                    <button class="btn add-to-cart-btn" data-id="2" data-name="Áo Thun Thể Thao Nam" data-price="350000">Thêm vào giỏ</button>
                </div>
            </div>

            <div class="product-item product-card">
                <img src="https://images.unsplash.com/photo-1611308725032-74f0a551d018?q=80&w=722&auto=format&fit=crop" alt="Áo khoác gió thể thao" class="product-img" />
                <div class="product-info">
                    <h3 class="product-title">Áo Khoác Gió Thể Thao Nam</h3>
                    <p class="product-price">550.000 đ</p>
                    <button class="btn add-to-cart-btn" data-id="9" data-name="Áo Khoác Gió Thể Thao Nam" data-price="550000">Thêm vào giỏ</button>
                </div>
            </div>

            <div class="product-item product-card">
                <img src="https://plus.unsplash.com/premium_photo-1747861981617-1512bc2c06e8?q=80&w=687&auto=format&fit=crop" alt="Áo polo thể thao" class="product-img" />
                <div class="product-info">
                    <h3 class="product-title">Áo Polo Thể Thao Nam</h3>
                    <p class="product-price">290.000 đ</p>
                    <button class="btn add-to-cart-btn" data-id="16" data-name="Áo Polo Thể Thao Nam" data-price="290000">Thêm vào giỏ</button>
                </div>
            </div>

        </div>
    </section>
</div>