@model IEnumerable<web_sport_gear.Models.Product>

@{
    ViewBag.Title = "Áo Thể Thao - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================
       GEAR SPORT - ADIDAS/PUMA CAMPAIGN STYLE
       ========================================== */

    /* 1. Hero Campaign Banner */
    .adidas-hero-campaign {
        position: relative;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        height: 480px;
        background: #0f172a;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
    }

        .adidas-hero-campaign img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            opacity: 0.85;
        }

    .adidas-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 60%, transparent 100% );
    }

    .adidas-hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: #ffffff;
        padding: 0 20px;
        max-width: 900px;
    }

    .adidas-breadcrumb {
        font-size: 12px;
        letter-spacing: 1px;
        color: #cbd5e1;
        text-transform: uppercase;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .adidas-hero-title {
        font-size: clamp(32px, 5vw, 56px);
        font-weight: 900;
        text-transform: uppercase;
        margin: 0 0 12px 0;
        letter-spacing: -1px;
    }

    .adidas-hero-desc {
        font-size: 15px;
        color: #e2e8f0;
        margin: 0;
        font-weight: 400;
        letter-spacing: 0.5px;
    }

    /* 2. Dải danh mục phụ */
    .sub-categories-bar {
        max-width: 1300px;
        margin: 0 auto 40px auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    .sub-cat-card {
        position: relative;
        height: 90px;
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e293b;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

        .sub-cat-card img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.5;
            transition: transform 0.4s ease;
        }

        .sub-cat-card:hover img {
            transform: scale(1.08);
            opacity: 0.7;
        }

        .sub-cat-card span {
            position: relative;
            z-index: 2;
            color: #ffffff;
            font-weight: 800;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.6);
        }

        .sub-cat-card.active,
        .sub-cat-card:hover {
            border-color: #ff5722;
        }

    /* 3. Bố cục chính */
    .adidas-catalog-container {
        max-width: 1300px;
        margin: 0 auto 60px auto;
        padding: 0 20px;
    }

    .adidas-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 15px;
    }

    .adidas-count {
        font-size: 14px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .adidas-sort select {
        padding: 8px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-weight: 600;
        font-size: 14px;
        outline: none;
        background: #fff;
        cursor: pointer;
    }

    /* 4. Lưới sản phẩm */
    .adidas-catalog-container .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    /* 5. Hiển thị tồn kho */
    .product-stock {
        font-size: 13px;
        margin: 8px 0;
        font-weight: 600;
        color: #16a34a;
    }

        .product-stock.out-of-stock {
            color: #dc2626;
        }

    /* 6. Nút thêm giỏ hàng khi hết hàng */
    .add-to-cart-btn:disabled {
        background: #9ca3af;
        border-color: #9ca3af;
        color: #ffffff;
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* 7. Responsive */
    @@media (max-width: 768px) {
        .adidas-hero-campaign {
            height: 350px;
        }

        .adidas-toolbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .adidas-catalog-container .product-grid {
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 18px;
        }
    }
    /* Liên kết đến trang chi tiết sản phẩm */
    .product-detail-link {
        color: inherit;
        text-decoration: none;
        cursor: pointer;
    }

        .product-detail-link:hover {
            color: #ff5722;
        }

    .product-img {
        cursor: pointer;
    }
</style>

<!-- 1. HERO CAMPAIGN BANNER -->
<div class="adidas-hero-campaign">
    <img src="https://images.unsplash.com/photo-1637666532931-b835a227b955?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
         alt="Áo Thể Thao Campaign" />

    <div class="adidas-hero-overlay"></div>

    <div class="adidas-hero-content">
        <div class="adidas-breadcrumb">
            Trang chủ / Áo Thể Thao
        </div>

        <h1 class="adidas-hero-title">
            Bộ Sưu Tập Áo Thể Thao
        </h1>

        <p class="adidas-hero-desc">
            Đột phá phong cách và tối ưu hiệu suất vận động với các thiết kế công nghệ cao cấp.
        </p>
    </div>
</div>

<!-- 2. THANH CHUYỂN NHANH DANH MỤC PHỤ -->

@{
    string selectedSubCategory = ViewBag.SelectedSubCategory as string;
}

<div class="sub-categories-bar">

    <a href="@Url.Action("AOTHETHAO", "Product")"
       class="sub-cat-card @(string.IsNullOrEmpty(selectedSubCategory) ? "active" : "")">
        <img src="https://images.unsplash.com/photo-1581655353564-df123a1eb820?w=400"
             alt="Tất cả áo" />
        <span>Tất cả áo</span>
    </a>

    <a href="@Url.Action("AOTHETHAO", "Product", new { subCategory = "Áo Thun Thể Thao" })"
       class="sub-cat-card @(selectedSubCategory == "Áo Thun Thể Thao" ? "active" : "")">
        <img src="https://images.unsplash.com/photo-1581655353564-df123a1eb820?w=400"
             alt="Áo thun thể thao" />
        <span>Áo Thun Thể Thao</span>
    </a>

    <a href="@Url.Action("AOTHETHAO", "Product", new { subCategory = "Áo Khoác Gió" })"
       class="sub-cat-card @(selectedSubCategory == "Áo Khoác Gió" ? "active" : "")">
        <img src="https://images.unsplash.com/photo-1611308725032-74f0a551d018?w=400"
             alt="Áo khoác gió" />
        <span>Áo Khoác Gió</span>
    </a>

    <a href="@Url.Action("AOTHETHAO", "Product", new { subCategory = "Áo Polo Thể Thao" })"
       class="sub-cat-card @(selectedSubCategory == "Áo Polo Thể Thao" ? "active" : "")">
        <img src="https://plus.unsplash.com/premium_photo-1747861981617-1512bc2c06e8?w=400"
             alt="Áo polo thể thao" />
        <span>Áo Polo Thể Thao</span>
    </a>

</div>


<!-- 3. KHU VỰC HIỂN THỊ SẢN PHẨM -->
<div class="adidas-catalog-container">

    <div class="adidas-toolbar">
        <span class="adidas-count">
            Hiển thị @Model.Count() sản phẩm chính hãng
        </span>

        <div class="adidas-sort">
            <select id="sortSelect">
                <option value="newest">Sắp xếp: Mới nhất</option>
                <option value="price-asc">Giá: Thấp đến cao</option>
                <option value="price-desc">Giá: Cao xuống thấp</option>
            </select>
        </div>
    </div>

    <section class="featured-products">
        <div class="product-container product-grid">

            @foreach (var product in Model)
            {
                <div class="product-item product-card"
                     data-id="@product.ProductID"
                     data-price="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                    <a href="@Url.Action("Details", "Home", new { id = product.ProductID })"
                       class="product-detail-link">
                        <img src="@product.ImageUrl"
                             alt="@product.ProductName"
                             class="product-img" />
                    </a>

                    <div class="product-info">

                        <h3 class="product-title">
                            <a href="@Url.Action("Details", "Home", new { id = product.ProductID })"
                               class="product-detail-link">
                                @product.ProductName
                            </a>
                        </h3>

                        <p class="product-price">
                            @product.Price.ToString("N0") đ
                        </p>

                        @if (product.StockQuantity > 0)
                        {
                            <p class="product-stock">
                                Còn hàng: @product.StockQuantity sản phẩm
                            </p>
                        }
                        else
                        {
                            <p class="product-stock out-of-stock">
                                Hết hàng
                            </p>
                        }

                        @if (product.StockQuantity > 0)
                        {
                            <button class="btn add-to-cart-btn"
                                    data-id="@product.ProductID"
                                    data-name="@product.ProductName"
                                    data-price="@product.Price"
                                    data-image="@product.ImageUrl"
                                    data-stock="@product.StockQuantity">
                                Thêm vào giỏ
                            </button>
                        }
                        else
                        {
                            <button class="btn add-to-cart-btn"
                                    data-id="@product.ProductID"
                                    data-name="@product.ProductName"
                                    data-price="@product.Price"
                                    data-image="@product.ImageUrl"
                                    data-stock="0"
                                    disabled>
                                Hết hàng
                            </button>
                        }

                    </div>
                </div>
            }

        </div>
    </section>
</div>
<script>document.addEventListener("DOMContentLoaded", function () {

        const sortSelect = document.getElementById("sortSelect");

        const productContainer = document.querySelector(
            ".adidas-catalog-container .product-grid"
        );

        if (!sortSelect || !productContainer) {
            return;
        }

        function sortProducts() {

            const products = Array.from(
                productContainer.querySelectorAll(".product-item")
            );

            const sortType = sortSelect.value;

            products.sort(function (a, b) {

                const priceA = parseFloat(a.dataset.price) || 0;
                const priceB = parseFloat(b.dataset.price) || 0;

                const idA = parseInt(a.dataset.id) || 0;
                const idB = parseInt(b.dataset.id) || 0;

                if (sortType === "price-asc") {
                    return priceA - priceB;
                }

                if (sortType === "price-desc") {
                    return priceB - priceA;
                }

                // Mới nhất: ID lớn hơn hiển thị trước
                return idB - idA;
            });

            products.forEach(function (product) {
                productContainer.appendChild(product);
            });
        }

        // Khi người dùng thay đổi lựa chọn
        sortSelect.addEventListener("change", sortProducts);

        // Áp dụng sắp xếp ngay khi mở trang
        sortProducts();

    });</script>