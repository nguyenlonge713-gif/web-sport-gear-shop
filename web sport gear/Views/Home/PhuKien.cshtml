
@model IEnumerable<web_sport_gear.Models.Product>

@{
    ViewBag.Title = "Phụ Kiện & Dụng Cụ - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================
       GEAR SPORT - ACCESSORIES CAMPAIGN STYLE
       ========================================== */

    /* 1. Hero Campaign Banner Tràn Viền */
    .acc-hero-campaign {
        position: relative;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        height: 480px;
        background: #0f172a;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
    }

        .acc-hero-campaign img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            opacity: 0.85;
        }

    .acc-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.25) 60%, transparent 100% );
    }

    .acc-hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: #ffffff;
        padding: 0 20px;
        max-width: 900px;
    }

    .acc-breadcrumb {
        font-size: 12px;
        letter-spacing: 1px;
        color: #cbd5e1;
        text-transform: uppercase;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .acc-hero-title {
        font-size: clamp(30px, 4.8vw, 54px);
        font-weight: 900;
        text-transform: uppercase;
        margin: 0 0 12px 0;
        letter-spacing: -1px;
    }

    .acc-hero-desc {
        font-size: 15px;
        color: #e2e8f0;
        margin: 0;
        font-weight: 400;
        letter-spacing: 0.5px;
    }

    /* 2. Dải danh mục phụ */
    .sub-categories-bar {
        max-width: 1300px;
        margin: 0 auto 40px auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    .sub-cat-card {
        position: relative;
        height: 95px;
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e293b;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

        .sub-cat-card img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.5;
            transition: transform 0.4s ease;
        }

        .sub-cat-card:hover img {
            transform: scale(1.08);
            opacity: 0.7;
        }

        .sub-cat-card span {
            position: relative;
            z-index: 2;
            color: #ffffff;
            font-weight: 800;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.6);
            text-align: center;
            padding: 0 10px;
        }

        .sub-cat-card.active,
        .sub-cat-card:hover {
            border-color: #ff5722;
        }

    /* 3. Bố cục chính */
    .acc-catalog-container {
        max-width: 1300px;
        margin: 0 auto 60px auto;
        padding: 0 20px;
    }

    .acc-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 15px;
    }

    .acc-count {
        font-size: 14px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .acc-sort select {
        padding: 8px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-weight: 600;
        font-size: 14px;
        outline: none;
        background: #fff;
        cursor: pointer;
    }

    .acc-catalog-container .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    /* 4. Hiển thị tồn kho */
    .product-stock {
        font-size: 13px;
        margin: 8px 0;
        font-weight: 600;
        color: #16a34a;
    }

        .product-stock.out-of-stock {
            color: #dc2626;
        }

    /* 5. Nút thêm giỏ hàng khi hết hàng */
    .add-to-cart-btn:disabled {
        background: #9ca3af;
        border-color: #9ca3af;
        color: #ffffff;
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* 6. Responsive */
    @@media (max-width: 768px) {
        .acc-hero-campaign {
            height: 350px;
        }

        .acc-toolbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .acc-catalog-container .product-grid {
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 18px;
        }
    }
</style>

<!-- 1. HERO CAMPAIGN BANNER -->
<div class="acc-hero-campaign">
    <img src="https://images.unsplash.com/photo-1637666544359-0e88de7b3206?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
         alt="Sports Accessories Campaign" />

    <div class="acc-hero-overlay"></div>

    <div class="acc-hero-content">
        <div class="acc-breadcrumb">
            Trang chủ / Phụ Kiện & Dụng Cụ
        </div>

        <h1 class="acc-hero-title">
            Bộ Sưu Tập Phụ Kiện Thể Thao
        </h1>

        <p class="acc-hero-desc">
            Trang bị hoàn hảo từ bình nước, bóng thi đấu, túi xách đến dụng cụ tập luyện chuyên nghiệp chính hãng.
        </p>
    </div>
</div>

<!-- 2. THANH CHUYỂN NHANH DANH MỤC PHỤ -->
<div class="sub-categories-bar">
    <a href="#" class="sub-cat-card active">
        <img src="https://images.unsplash.com/photo-1518091043644-c1d4457512c6?w=400"
             alt="Tất cả phụ kiện" />
        <span>Tất cả phụ kiện</span>
    </a>

    <a href="#" class="sub-cat-card">
        <img src="https://images.unsplash.com/photo-1623285512357-ff3b9a7579ea?w=400"
             alt="Trang Phục Thể Thao" />
        <span>Trang Phục</span>
    </a>

    <a href="#" class="sub-cat-card">
        <img src="https://images.unsplash.com/photo-1602143407151-7111542de6e8?w=400"
             alt="Bình Nước & Balo" />
        <span>Bình Nước & Balo</span>
    </a>

    <a href="#" class="sub-cat-card">
        <img src="https://images.unsplash.com/photo-1687597778602-624a9438fe0b?w=400"
             alt="Dụng Cụ Thi Đấu" />
        <span>Dụng Cụ Thi Đấu</span>
    </a>
</div>

<!-- 3. KHU VỰC HIỂN THỊ SẢN PHẨM -->
<div class="acc-catalog-container">

    <div class="acc-toolbar">
        <span class="acc-count">
            Hiển thị <strong>@Model.Count()</strong> sản phẩm chính hãng
        </span>

        <div class="acc-sort">
            <select id="sortSelect">
                <option>Sắp xếp: Mới nhất</option>
                <option>Giá: Thấp đến cao</option>
                <option>Giá: Cao xuống thấp</option>
            </select>
        </div>
    </div>

    <section class="featured-products">
        <div class="product-container product-grid">

            @foreach (var product in Model)
            {
                <div class="product-item product-card">

                    <img src="@product.ImageUrl"
                         alt="@product.ProductName"
                         class="product-img" />

                    <div class="product-info">

                        <h3 class="product-title">
                            @product.ProductName
                        </h3>

                        <p class="product-price">
                            @product.Price.ToString("N0") đ
                        </p>

                        @if (product.StockQuantity > 0)
                        {
                            <p class="product-stock">
                                Còn hàng: @product.StockQuantity sản phẩm
                            </p>
                        }
                        else
                        {
                            <p class="product-stock out-of-stock">
                                Hết hàng
                            </p>
                        }

                        @if (product.StockQuantity > 0)
                        {
                            <button class="btn add-to-cart-btn"
                                    data-id="@product.ProductID"
                                    data-name="@product.ProductName"
                                    data-price="@product.Price"
                                    data-image="@product.ImageUrl"
                                    data-stock="@product.StockQuantity">
                                Thêm vào giỏ
                            </button>
                        }
                        else
                        {
                            <button class="btn add-to-cart-btn"
                                    data-id="@product.ProductID"
                                    data-name="@product.ProductName"
                                    data-price="@product.Price"
                                    data-image="@product.ImageUrl"
                                    data-stock="0"
                                    disabled>
                                Hết hàng
                            </button>
                        }

                    </div>
                </div>
            }

        </div>
    </section>
</div>
