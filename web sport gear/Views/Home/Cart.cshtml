
@{
    ViewBag.Title = "Giỏ Hàng - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="background:white; padding:30px; border-radius:6px; box-shadow:0 2px 5px rgba(0,0,0,0.1); margin-top:20px;">

    <h2 style="margin-bottom:20px; border-left:5px solid #ff4500; padding-left:10px;">
        Giỏ Hàng Của Bạn
    </h2>

    <table style="width:100%; border-collapse:collapse; text-align:left; margin-bottom:20px;">

        <thead>
            <tr style="border-bottom:2px solid #ddd; background:#f9f9f9;">
                <th style="padding:12px;">Sản phẩm</th>
                <th style="padding:12px;">Đơn giá</th>
                <th style="padding:12px;">Số lượng</th>
                <th style="padding:12px;">Thành tiền</th>
                <th style="padding:12px;">Thao tác</th>
            </tr>
        </thead>

        <tbody id="cart-items">
            <tr>
                <td colspan="5" style="text-align:center; padding:30px;">
                    Đang tải giỏ hàng...
                </td>
            </tr>
        </tbody>

    </table>

    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:15px; border-top:2px solid #ddd; padding-top:20px;">

        <h3 style="font-size:20px; margin:0;">
            Tổng thanh toán:
            <span id="cart-total" style="color:#ff4500;">0 đ</span>
        </h3>

        <div style="display:flex; align-items:center; flex-wrap:wrap; gap:12px;">

            <a href="@Url.Action("Index", "Home")"
               style="text-decoration:none; padding:12px 20px; font-size:16px; background-color:#ff4500; color:white; border-radius:6px; font-weight:bold; display:inline-block;">
                ← Tiếp Tục Mua Hàng
            </a>

            <a href="@Url.Action("Index", "Checkout")"
               id="checkout-btn"
               style="text-decoration:none; padding:12px 25px; font-size:16px; background-color:#ff9800; color:white; border-radius:6px; font-weight:bold; display:inline-block; cursor:pointer;">
                Tiến Hành Thanh Toán
            </a>

        </div>

    </div>

</div>

<script>

    document.addEventListener("DOMContentLoaded", async function () {

        const checkoutBtn = document.getElementById("checkout-btn");

        // Đồng bộ giỏ hàng từ SQL Server
        const success = await syncCartFromServer();

        if (!success) {
            showCartError();
        }

        // Kiểm tra giỏ hàng trước khi thanh toán
        if (checkoutBtn) {

            checkoutBtn.addEventListener("click", async function (event) {

                event.preventDefault();

                const synced = await syncCartFromServer();

                if (!synced) {
                    alert("Không thể kiểm tra giỏ hàng. Vui lòng thử lại.");
                    return;
                }

                const cart = getCart();

                if (!hasValidCart(cart)) {
                    alert("Giỏ hàng đang trống! Vui lòng thêm sản phẩm trước khi thanh toán.");
                    return;
                }

                window.location.href = checkoutBtn.href;

            });

        }

    });


    // Kiểm tra giỏ hàng hợp lệ
    function hasValidCart(cart) {

        if (!Array.isArray(cart) || cart.length === 0) {
            return false;
        }

        return cart.every(function (item) {

            const price = Number(item.price);
            const quantity = Number(item.quantity);

            return item &&
                Number.isInteger(Number(item.id)) &&
                Number(item.id) > 0 &&
                Number.isFinite(price) &&
                price > 0 &&
                Number.isInteger(quantity) &&
                quantity > 0;

        });

    }


    // Hiển thị lỗi khi không lấy được giỏ hàng
    function showCartError() {

        const tbody = document.getElementById("cart-items");

        const total = document.getElementById("cart-total");

        if (tbody) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="5"
                        style="text-align:center; padding:30px; color:#dc2626;">
                        Không thể tải giỏ hàng. Vui lòng tải lại trang.
                    </td>
                </tr>
            `;
        }

        if (total) {
            total.textContent = "0 đ";
        }

    }

</script>
