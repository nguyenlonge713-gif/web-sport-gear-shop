@{
    ViewBag.Title = "Giày Đá Bóng & Thể Thao - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Phần Tiêu Đề Danh Mục -->
<section style="margin: 30px 0; text-align: center;">
    <h2>Danh Mục Giày Thể Thao & Đá Banh</h2>
    <p>Khám phá các mẫu giày đá banh sân cỏ nhân tạo, giày chạy bộ và giày bóng rổ chính hãng.</p>
</section>

<!-- Phần Danh Sách Sản Phẩm Giày -->
<section class="featured-products">
    <div class="product-container product-grid" style="margin-top: 20px;">

        <!-- Giày Chạy Bộ Nike Air -->
        <div class="product-item product-card">
            <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff" alt="Giày chạy bộ" class="product-img" />
            <div class="product-info">
                <h3 class="product-title">Giày Chạy Bộ Nike Air</h3>
                <p class="product-price">1.500.000 đ</p>
                <button class="btn add-to-cart-btn" data-id="1" data-name="Giày Chạy Bộ Nike Air" data-price="1500000">Thêm vào giỏ</button>
            </div>
        </div>

        <!-- Giày Bóng Rổ Nam Cao Cấp -->
        <div class="product-item product-card">
            <img src="https://images.unsplash.com/photo-1579338559194-a162d19bf842" alt="Giày bóng rổ" class="product-img" />
            <div class="product-info">
                <h3 class="product-title">Giày Bóng Rổ Nam Cao Cấp</h3>
                <p class="product-price">1.650.000 đ</p>
                <button class="btn add-to-cart-btn" data-id="15" data-name="Giày Bóng Rổ Nam Cao Cấp" data-price="1650000">Thêm vào giỏ</button>
            </div>
        </div>

        <!-- Giày Đá Banh Sân Cỏ Nhân Tạo -->
        <div class="product-item product-card">
            <img src="https://images.unsplash.com/photo-1511886929837-354d827aae26?q=80&w=764&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Giày đá banh" class="product-img" />
            <div class="product-info">
                <h3 class="product-title">Giày Đá Banh Sân Cỏ Nhân Tạo</h3>
                <p class="product-price">890.000 đ</p>
                <button class="btn add-to-cart-btn" data-id="17" data-name="Giày Đá Banh Sân Cỏ Nhân Tạo" data-price="890000">Thêm vào giỏ</button>
            </div>
        </div>

        <!-- Giày Chạy Bộ Nam Lightweight -->
        <div class="product-item product-card">
            <img src="https://images.unsplash.com/photo-1562183241-b937e95585b6?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTJ8fGdpJUMzJUEweSUyMGNoJUUxJUJBJUExeSUyMGIlRTElQkIlOTl8ZW58MHx8MHx8fDA%3D" alt="Giày chạy bộ nam" class="product-img" />
            <div class="product-info">
                <h3 class="product-title">Giày Chạy Bộ Nam Lightweight</h3>
                <p class="product-price">1.350.000 đ</p>
                <button class="btn add-to-cart-btn" data-id="18" data-name="Giày Chạy Bộ Nam Lightweight" data-price="1350000">Thêm vào giỏ</button>
            </div>
        </div>

    </div>
</section>