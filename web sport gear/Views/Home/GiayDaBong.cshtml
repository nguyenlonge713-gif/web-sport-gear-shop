
@model IEnumerable<web_sport_gear.Models.Product>

@{
    ViewBag.Title = "Giày Đá Bóng & Thể Thao - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string selectedSubCategory = ViewBag.SelectedSubCategory as string;

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalProducts = ViewBag.TotalProducts;
}

<style>
    /* ==========================================
       GEAR SPORT - FOOTBALL & SHOES CAMPAIGN STYLE
       ========================================== */

    /* 1. Hero Campaign Banner */
    .shoes-hero-campaign {
        position: relative;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        height: 480px;
        background: #0f172a;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 30px;
    }

        .shoes-hero-campaign img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            opacity: 0.85;
        }

    .shoes-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.25) 60%, transparent 100% );
    }

    .shoes-hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: #ffffff;
        padding: 0 20px;
        max-width: 900px;
    }

    .shoes-breadcrumb {
        font-size: 12px;
        letter-spacing: 1px;
        color: #cbd5e1;
        text-transform: uppercase;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .shoes-hero-title {
        font-size: clamp(30px, 4.8vw, 54px);
        font-weight: 900;
        text-transform: uppercase;
        margin: 0 0 12px 0;
        letter-spacing: -1px;
    }

    .shoes-hero-desc {
        font-size: 15px;
        color: #e2e8f0;
        margin: 0;
        font-weight: 400;
        letter-spacing: 0.5px;
    }

    /* 2. Dải danh mục phụ */
    .sub-categories-bar {
        max-width: 1300px;
        margin: 0 auto 40px auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    .sub-cat-card {
        position: relative;
        height: 95px;
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e293b;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

        .sub-cat-card img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.5;
            transition: transform 0.4s ease;
        }

        .sub-cat-card:hover img {
            transform: scale(1.08);
            opacity: 0.7;
        }

        .sub-cat-card span {
            position: relative;
            z-index: 2;
            color: #ffffff;
            font-weight: 800;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.6);
        }

        .sub-cat-card.active,
        .sub-cat-card:hover {
            border-color: #ff5722;
        }

    /* 3. Bố cục sản phẩm */
    .shoes-catalog-container {
        max-width: 1300px;
        margin: 0 auto 60px auto;
        padding: 0 20px;
    }

    .shoes-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 15px;
    }

    .shoes-count {
        font-size: 14px;
        color: #64748b;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .shoes-sort select {
        padding: 8px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        font-weight: 600;
        font-size: 14px;
        outline: none;
        background: #fff;
        cursor: pointer;
    }

    .shoes-catalog-container .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    /* 4. Hiển thị tồn kho */
    .product-stock {
        font-size: 13px;
        margin: 8px 0;
        font-weight: 600;
        color: #16a34a;
    }

        .product-stock.out-of-stock {
            color: #dc2626;
        }

    /* 5. Nút thêm giỏ hàng khi hết hàng */
    .add-to-cart-btn:disabled {
        background: #9ca3af;
        border-color: #9ca3af;
        color: #ffffff;
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* 6. Responsive */
    @@media (max-width: 768px) {
        .shoes-hero-campaign {
            height: 350px;
        }

        .shoes-toolbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .shoes-catalog-container .product-grid {
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 18px;
        }
    }

    /* 7. Liên kết chi tiết */
    .product-detail-link {
        color: inherit;
        text-decoration: none;
        cursor: pointer;
    }

        .product-detail-link:hover {
            color: #ff5722;
        }

    .product-img {
        cursor: pointer;
    }

    /* 8. Phân trang */
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin: 40px 0 20px;
    }

        .pagination-container a {
            min-width: 42px;
            height: 42px;
            padding: 0 14px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            border: 1px solid #cbd5e1;
            border-radius: 5px;
            color: #1e293b;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .pagination-container a:hover {
                background: #ff5722;
                color: #fff;
                border-color: #ff5722;
            }

            .pagination-container a.active {
                background: #ff5722;
                color: #fff;
                border-color: #ff5722;
            }

            .pagination-container a.disabled {
                pointer-events: none;
                opacity: 0.4;
            }

    .pagination-info {
        text-align: center;
        color: #64748b;
        font-size: 14px;
        margin-top: 12px;
    }
</style>

<!-- 1. HERO CAMPAIGN BANNER -->
<div class="shoes-hero-campaign">

    <img src="https://plus.unsplash.com/premium_photo-1663133611323-69d98d17de90?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
         alt="Football Shoes Campaign" />

    <div class="shoes-hero-overlay"></div>

    <div class="shoes-hero-content">

        <div class="shoes-breadcrumb">
            Trang chủ / Giày Đá Bóng & Thể Thao
        </div>

        <h1 class="shoes-hero-title">
            Bộ Sưu Tập Giày Thể Thao
        </h1>

        <p class="shoes-hero-desc">
            Bứt phá tốc độ, làm chủ sân cỏ và chinh phục mọi giới hạn cùng các dòng giày chuyên nghiệp chính hãng.
        </p>

    </div>
</div>

<!-- 2. THANH CHUYỂN NHANH DANH MỤC PHỤ -->
<div class="sub-categories-bar">

    <!-- Tất cả giày -->
    <a href="@Url.Action("GiayDaBong", "Product")"
       class="sub-cat-card @(string.IsNullOrEmpty(selectedSubCategory) ? "active" : "")">

        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400"
             alt="Tất cả giày" />

        <span>Tất cả giày</span>
    </a>

    <!-- Giày Đá Banh -->
    <a href="@Url.Action("GiayDaBong", "Product", new { subCategory = "Giày Đá Banh" })"
       class="sub-cat-card @(selectedSubCategory == "Giày Đá Banh" ? "active" : "")">

        <img src="https://images.unsplash.com/photo-1511886929837-354d827aae26?w=400"
             alt="Giày Đá Banh" />

        <span>Giày Đá Banh</span>
    </a>

    <!-- Giày Chạy Bộ -->
    <a href="@Url.Action("GiayDaBong", "Product", new { subCategory = "Giày Chạy Bộ" })"
       class="sub-cat-card @(selectedSubCategory == "Giày Chạy Bộ" ? "active" : "")">

        <img src="https://images.unsplash.com/photo-1562183241-b937e95585b6?w=400"
             alt="Giày Chạy Bộ" />

        <span>Giày Chạy Bộ</span>
    </a>

    <!-- Giày Bóng Rổ -->
    <a href="@Url.Action("GiayDaBong", "Product", new { subCategory = "Giày Bóng Rổ" })"
       class="sub-cat-card @(selectedSubCategory == "Giày Bóng Rổ" ? "active" : "")">

        <img src="https://images.unsplash.com/photo-1579338559194-a162d19bf842?w=400"
             alt="Giày Bóng Rổ" />

        <span>Giày Bóng Rổ</span>
    </a>

</div>

<!-- 3. KHU VỰC HIỂN THỊ SẢN PHẨM -->
<div class="shoes-catalog-container">

    <div class="shoes-toolbar">

        <span class="shoes-count">
            Tổng cộng <strong>@totalProducts</strong> sản phẩm chính hãng
        </span>

        <div class="shoes-sort">
            <select id="sortSelect">
                <option value="newest">Sắp xếp: Mới nhất</option>
                <option value="price-asc">Giá: Thấp đến cao</option>
                <option value="price-desc">Giá: Cao xuống thấp</option>
            </select>
        </div>

    </div>

    <section class="featured-products">

        <div class="product-container product-grid">

            @if (Model != null && Model.Any())
            {
                foreach (var product in Model)
                {
                    <div class="product-item product-card"
                         data-id="@product.ProductID"
                         data-price="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                        <a href="@Url.Action("Details", "Home", new { id = product.ProductID })"
                           class="product-detail-link">

                            <img src="@product.ImageUrl"
                                 alt="@product.ProductName"
                                 class="product-img" />

                        </a>

                        <div class="product-info">

                            <h3 class="product-title">

                                <a href="@Url.Action("Details", "Home", new { id = product.ProductID })"
                                   class="product-detail-link">
                                    @product.ProductName
                                </a>

                            </h3>

                            <p class="product-price">
                                @product.Price.ToString("N0") đ
                            </p>

                            @if (product.StockQuantity > 0)
                            {
                                <p class="product-stock">
                                    Còn hàng: @product.StockQuantity sản phẩm
                                </p>
                            }
                            else
                            {
                                <p class="product-stock out-of-stock">
                                    Hết hàng
                                </p>
                            }

                            @if (product.StockQuantity > 0)
                            {
                                <button class="btn add-to-cart-btn"
                                        data-id="@product.ProductID"
                                        data-name="@product.ProductName"
                                        data-price="@product.Price"
                                        data-image="@product.ImageUrl"
                                        data-stock="@product.StockQuantity">
                                    Thêm vào giỏ
                                </button>
                            }
                            else
                            {
                                <button class="btn add-to-cart-btn"
                                        data-id="@product.ProductID"
                                        data-name="@product.ProductName"
                                        data-price="@product.Price"
                                        data-image="@product.ImageUrl"
                                        data-stock="0"
                                        disabled>
                                    Hết hàng
                                </button>
                            }

                        </div>
                    </div>
                }
            }
            else
            {
                <p>Hiện chưa có sản phẩm nào trong danh mục này.</p>
            }

        </div>

    </section>

    <!-- 4. THANH PHÂN TRANG -->
    @if (totalPages > 1)
    {
        <div class="pagination-container">

            <!-- Trang trước -->
            <a href="@Url.Action("GiayDaBong", "Product", new {
                    page = currentPage - 1,
                    subCategory = selectedSubCategory
                })"
               class="@(currentPage == 1 ? "disabled" : "")">
                &laquo; Trước
            </a>

            <!-- Các số trang -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <a href="@Url.Action("GiayDaBong", "Product", new {
                        page = i,
                        subCategory = selectedSubCategory
                    })"
                   class="@(i == currentPage ? "active" : "")">
                    @i
                </a>
            }

            <!-- Trang sau -->
            <a href="@Url.Action("GiayDaBong", "Product", new {
                    page = currentPage + 1,
                    subCategory = selectedSubCategory
                })"
               class="@(currentPage == totalPages ? "disabled" : "")">
                Sau &raquo;
            </a>

        </div>

        <div class="pagination-info">
            Trang @currentPage / @totalPages
        </div>
    }

</div>

<!-- 5. JAVASCRIPT SẮP XẾP SẢN PHẨM -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const sortSelect = document.getElementById("sortSelect");

        const productContainer = document.querySelector(
            ".shoes-catalog-container .product-grid"
        );

        if (!sortSelect || !productContainer) {
            return;
        }

        function sortProducts() {

            const products = Array.from(
                productContainer.querySelectorAll(".product-item")
            );

            const sortType = sortSelect.value;

            products.sort(function (a, b) {

                const priceA = parseFloat(a.dataset.price) || 0;
                const priceB = parseFloat(b.dataset.price) || 0;

                const idA = parseInt(a.dataset.id) || 0;
                const idB = parseInt(b.dataset.id) || 0;

                if (sortType === "price-asc") {
                    return priceA - priceB;
                }

                if (sortType === "price-desc") {
                    return priceB - priceA;
                }

                return idB - idA;
            });

            products.forEach(function (product) {
                productContainer.appendChild(product);
            });
        }

        sortSelect.addEventListener("change", sortProducts);

        sortProducts();

    });
</script>
