                    <button type="button" id="decreaseQtyBtn" style="padding: 6px 12px; background: #f3f4f6; border: none; cursor: pointer;">-</button>
                    <input type="number" id="modalQuantityInput" value="1" min="1" max="100" style="width: 50px; text-align: center; border: none; outline: none; font-size: 14px;" />
                    <button type="button" id="increaseQtyBtn" style="padding: 6px 12px; background: #f3f4f6; border: none; cursor: pointer;">+</button>
                </div>
            </div>

            <!-- Nút thêm vào giỏ hàng -->
            <button id="modalAddToCart" class="btn add-to-cart-btn" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; padding: 14px 20px; border: none; border-radius: 10px; cursor: pointer; font-size: 16px; font-weight: bold; text-align: center; box-shadow: 0 4px 12px rgba(37,99,235,0.3); transition: all 0.2s;">
                🛒 Thêm vào giỏ hàng ngay
            </button>
        </div>

        <!-- Chức năng tìm kiếm sản phẩm trên thanh tìm kiếm-->
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const searchInput = document.getElementById("search-input");
                const searchButton = document.getElementById("search-button");
                const productItems = document.querySelectorAll(".product-item");

                function filterProducts() {
                    if (!searchInput) return;
                    const keyword = searchInput.value.toLowerCase().trim();

                    productItems.forEach(item => {
                        const titleEl = item.querySelector(".product-title");
                        const title = titleEl ? titleEl.textContent.toLowerCase() : "";

                        // Nếu từ khóa khớp với tiêu đề sản phẩm
                        if (title.includes(keyword)) {
                            item.style.display = ""; // Trả về trạng thái hiển thị mặc định của CSS
                        } else {
                            item.style.display = "none"; // Ẩn hẳn đi
                        }
                    });
                }

                // Bấm nút tìm kiếm
                if (searchButton) {
                    searchButton.addEventListener("click", function (e) {
                        e.preventDefault();
                        filterProducts();
                    });
                }

                // Gõ phím trực tiếp
                if (searchInput) {
                    searchInput.addEventListener("keyup", function () {
                        filterProducts();
                    });
                }
            });
        </script>
    </div>
</div>