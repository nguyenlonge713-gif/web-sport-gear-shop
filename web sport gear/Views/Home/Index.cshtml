<!-- 4. HELLO WINTER -->
<section class="home-section" id="helloWinterSection">
    <h2 class="section-header-title">HELLO WINTER ❄️</h2>

    <div class="custom-tabs" id="winterTabs">
        <button type="button" class="tab-btn active" data-filter="limited">LIMITED SALES</button>
        <button type="button" class="tab-btn" data-filter="extra">SALE 10%</button>
        <button type="button" class="tab-btn" data-filter="sale">SALE 20% - 30%</button>
    </div>

    <div class="product-grid-5" id="winterProductGrid">

        @foreach (var id in winterProductIds)
        {
            var product = FindProduct(id);

            if (product != null)
            {
                <div class="product-card-mini" data-product-id="@product.ProductID">

                    @if (!string.IsNullOrEmpty(GetBadge(id)))
                    {
                        <span class="badge-tag">@GetBadge(id)</span>
                    }

                    @if (newProductIds.Contains(id))
                    {
                        <span class="badge-tag new">NEW</span>
                    }

                    <a href="@Url.Action("Details", "Home", new { id = product.ProductID })">
                        <img src="@product.ImageUrl"
                             alt="@product.ProductName" />
                    </a>

                    <div>
                        <span class="mini-brand">@GetBrand(id)</span>

                        <a href="@Url.Action("Details", "Home", new { id = product.ProductID })">
                            <h3 class="mini-title">@product.ProductName</h3>
                        </a>

                        <span class="mini-price">
                            @FormatPrice(product.Price) đ
                        </span>

                        <span class="mini-stock @(product.StockQuantity <= 0 ? "out-of-stock" : "")">
                            @(product.StockQuantity > 0
                                ? "Còn " + product.StockQuantity + " sản phẩm"
                                : "Hết hàng")
                        </span>
                    </div>

                    <button class="btn add-to-cart-btn"
                            data-id="@product.ProductID"
                            data-name="@product.ProductName"
                            data-image="@product.ImageUrl"
                            data-price="@product.Price.ToString("0.##", CultureInfo.InvariantCulture)"
                            data-stock="@product.StockQuantity"
                            @(product.StockQuantity <= 0 ? "disabled" : "")>
                        @(product.StockQuantity > 0 ? "Thêm vào giỏ" : "Hết hàng")
                    </button>
                </div>
            }
        }

        @if (!winterProductIds.Any(id => homeProducts.Any(p => p.ProductID == id)))
        {
            <p style="grid-column:1/-1;text-align:center;padding:20px;">
                Hiện chưa có sản phẩm trong danh mục này.
            </p>
        }
    </div>

    <a href="@Url.Action("AoTheThao", "Home")" class="btn-view-more">
        Xem tất cả
    </a>
</section>

