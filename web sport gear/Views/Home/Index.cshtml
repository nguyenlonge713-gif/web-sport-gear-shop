                     alt="KM 1" />
                <div class="news-info">
                    <h4>ĐÓN DIỆN MẠO MỚI CÙNG GEAR SPORT - VOUCHER UP TO 100K</h4>
                    <p>Giảm ngay cho hóa đơn từ 500k khi đăng ký thành viên mới tại cửa hàng.</p>
                </div>
            </div>

            <div class="news-item">
                <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=300"
                     alt="KM 2" />
                <div class="news-info">
                    <h4>TƯNG BỪNG KHAI TRƯƠNG CHI NHÁNH MỚI - GIẢM GIÁ 50%</h4>
                    <p>Ưu đãi cực sốc dành riêng cho bộ sưu tập giày bóng đá và quần áo tập gym.</p>
                </div>
            </div>

            <a href="#" class="btn-view-more" style="margin-top: 15px;">
                Xem tất cả
            </a>
        </div>

    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {

    // Lưu vị trí ban đầu của các thẻ sản phẩm
    const allCards = Array.from(
        document.querySelectorAll('.product-card-mini')
    );

    const originalPositions = allCards.map(function (card) {
        const marker = document.createComment('product-card-position');

        card.parentNode.insertBefore(marker, card);

        return {
            card: card,
            marker: marker
        };
    });

    const winterGrid = document.getElementById('winterProductGrid');
    const trendingGrid = document.getElementById('trendingProductGrid');

    const winterTabs = document.getElementById('winterTabs');
    const trendingTabs = document.getElementById('trendingTabs');

    function restoreCards() {
        originalPositions.forEach(function (item) {
            item.card.style.display = '';

            if (item.marker.parentNode) {
                item.marker.parentNode.insertBefore(
                    item.card,
                    item.marker
                );
            }
        });
    }

    function setActiveTab(container, selected) {
        if (!container) return;

        container.querySelectorAll('.tab-btn').forEach(function (tab) {
            tab.classList.toggle('active', tab === selected);
        });
    }

    function titleOf(card) {
        return (
            card.querySelector('.mini-title')?.textContent || ''
        ).trim().toLowerCase();
    }

    function discountOf(card) {
        const badges = Array.from(
            card.querySelectorAll('.badge-tag')
        );

        for (const badge of badges) {
            const match = badge.textContent.match(/-\s*(\d+)\s*%/);

            if (match) {
                return Number(match[1]);
            }
        }

        return 0;
    }

    function showEmptyMessage(grid, message) {
        let notice = grid.querySelector('.tab-empty-message');

        if (!notice) {
            notice = document.createElement('p');
            notice.className = 'tab-empty-message';
            notice.style.gridColumn = '1 / -1';
            notice.style.textAlign = 'center';
            notice.style.padding = '20px';

            grid.appendChild(notice);
        }

        notice.textContent = message;
    }

    function clearEmptyMessage(grid) {
        const notice = grid.querySelector('.tab-empty-message');

        if (notice) {
            notice.remove();
        }
    }

    // TAB HELLO WINTER
    if (winterTabs && winterGrid) {

        winterTabs.querySelectorAll('.tab-btn').forEach(function (tab) {

            tab.addEventListener('click', function () {

                setActiveTab(winterTabs, tab);

                restoreCards();
                clearEmptyMessage(winterGrid);

                const filter = tab.dataset.filter;
                let selected = [];

                if (filter === 'limited') {

                    selected = originalPositions
                        .filter(function (item) {
                            return item.marker.parentNode === winterGrid;
                        })
                        .map(function (item) {
                            return item.card;
                        });

                } else if (filter === 'extra') {

                    selected = allCards.filter(function (card) {
                        return /áo|polo|t-shirt|shirt|jacket|hoodie/.test(
                            titleOf(card)
                        );
                    });

                } else if (filter === 'sale') {

                    selected = allCards.filter(function (card) {
                        const discount = discountOf(card);

                        return discount >= 20 && discount <= 30;
                    });
                }

                originalPositions.forEach(function (item) {

                    if (item.marker.parentNode === winterGrid) {
                        item.card.style.display = 'none';
                    }

                });

                selected.forEach(function (card) {
                    card.style.display = '';
                    winterGrid.appendChild(card);
                });

                if (selected.length === 0) {
                    showEmptyMessage(
                        winterGrid,
                        'Chưa có sản phẩm phù hợp với mục này.'
                    );
                }

            });

        });
    }

    // TAB TRENDING
    if (trendingTabs && trendingGrid) {

        trendingTabs.querySelectorAll('.tab-btn').forEach(function (tab) {

            tab.addEventListener('click', function () {

                setActiveTab(trendingTabs, tab);

                if (tab.dataset.filter === 'voucher') {

                    restoreCards();
                    clearEmptyMessage(trendingGrid);

                    return;
                }

                if (tab.dataset.filter === 'racket') {

                    window.location.href =
                        '@Url.Action("PhuKien", "Home")';

                }

            });

        });
    }

    // Đồng bộ ảnh trên nút thêm giỏ hàng nếu ảnh bị bỏ trống
    document.querySelectorAll('.add-to-cart-btn').forEach(function (button) {

        const card = button.closest('.product-card-mini');
        const img = card ? card.querySelector('img') : null;

        if (
            (!button.dataset.image || !button.dataset.image.trim())
            && img
        ) {
            button.dataset.image = img.getAttribute('src') || '';
        }

    });

});
</script>
