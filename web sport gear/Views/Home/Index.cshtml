
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@using web_sport_gear.Models

@{
    ViewBag.Title = "Trang Chủ - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Danh sách sản phẩm lấy từ HomeController
    var homeProducts = ViewBag.HomeProducts as List<Product>
                       ?? new List<Product>();

    // Thứ tự sản phẩm tại từng khu vực
    int[] winterProductIds = { 1, 18, 17, 15, 2 };
    int[] trendingProductIds = { 9, 4, 5, 6, 16 };

    // Thương hiệu hiện tại của từng sản phẩm
    var productBrands = new Dictionary<int, string>
{
        { 1, "NIKE" },
        { 18, "ADIDAS" },
        { 17, "PUMA" },
        { 15, "ASICS" },
        { 2, "GEAR SPORT" },
        { 9, "ADIDAS" },
        { 4, "GEAR SPORT" },
        { 5, "MOLTEN" },
        { 6, "PRO GOAL" },
        { 16, "NIKE" }
    };

    // Nhãn khuyến mãi hiện tại
    var productBadges = new Dictionary<int, string>
{
        { 1, "-20%" },
        { 18, "-15%" },
        { 17, "-25%" },
        { 2, "-10%" }
    };

    var newProductIds = new HashSet<int> { 1, 15 };

    // Lấy sản phẩm theo ID
    Func<int, Product> FindProduct = id =>
        homeProducts.FirstOrDefault(p => p.ProductID == id);

    // Lấy thương hiệu
    Func<int, string> GetBrand = id =>
        productBrands.ContainsKey(id)
            ? productBrands[id]
            : "GEAR SPORT";

    // Lấy nhãn giảm giá
    Func<int, string> GetBadge = id =>
        productBadges.ContainsKey(id)
            ? productBadges[id]
            : "";

    // Định dạng giá tiền
    Func<decimal, string> FormatPrice = price =>
        price.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"));
}

