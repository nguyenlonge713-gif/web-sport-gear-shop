@{
    ViewBag.Title = "Trang Chủ - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================
       GEAR SPORT - TOP HERO & BANNER STYLES
       ========================================== */

    /* 1. Thanh Tiêu Chuẩn Service Bar */
    .top-service-bar {
        background: #fafafa;
        border-bottom: 1px solid #eee;
        padding: 8px 0;
        font-size: 12px;
        color: #444;
    }

    .service-container {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        justify-content: space-around;
        align-items: center;
        text-align: center;
    }

    .service-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
    }

    .service-item i {
        color: #ff5722;
        font-size: 14px;
    }

    /* 2. Hero Banner Lớn (Slider/Campaign) */
    .hero-banner-wrapper {
        max-width: 1300px;
        margin: 20px auto;
        padding: 0 20px;
    }

    .main-hero-banner {
        position: relative;
        width: 100%;
        height: 420px;
        border-radius: 12px;
        overflow: hidden;
        background: #000;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }

    .main-hero-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    /* 3. Bộ 3 Banner Phụ (3 Columns Grid) */
    .sub-banners-grid {
        max-width: 1300px;
        margin: 20px auto 40px auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .sub-banner-card {
        position: relative;
        height: 360px;
        border-radius: 12px;
        overflow: hidden;
        display: block;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .sub-banner-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    .sub-banner-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .sub-banner-card:hover img {
        transform: scale(1.05);
    }

    .sub-banner-content {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 60%, transparent 100%);
        padding: 25px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: #ffffff;
    }

    .sub-banner-title {
        font-size: 22px;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
        color: #facc15; /* Màu vàng nổi bật */
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .sub-banner-subtitle {
        font-size: 13px;
        color: #e2e8f0;
        margin-top: 5px;
        font-weight: 500;
    }

    .btn-action-yellow {
        align-self: flex-start;
        background: #facc15;
        color: #000;
        font-weight: 800;
        font-size: 12px;
        padding: 8px 18px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        box-shadow: 0 3px 8px rgba(0,0,0,0.2);
    }

    /* Layout Sections */
    .home-section {
        max-width: 1300px;
        margin: 0 auto 50px auto;
        padding: 0 20px;
    }

    .section-header-title {
        text-align: center;
        font-size: 24px;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 15px;
        color: #1e293b;
        letter-spacing: 0.5px;
    }

    .custom-tabs {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 25px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 10px;
    }

    .tab-btn {
        background: none;
        border: none;
        font-size: 13px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        cursor: pointer;
        padding: 6px 12px;
        transition: all 0.2s;
    }

    .tab-btn.active, .tab-btn:hover {
        color: #ff5722;
        border-bottom: 2px solid #ff5722;
    }

    .product-grid-5 {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    /* Thẻ sản phẩm mini */
    .product-card-mini {
        background: #ffffff;
        border-radius: 8px;
        border: 1px solid #f1f5f9;
        padding: 12px;
        position: relative;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .product-card-mini:hover {
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        transform: translateY(-3px);
    }

    .product-card-mini a {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .product-card-mini a:hover .mini-title {
        color: #ff5722;
    }

    .badge-tag {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #ff5722;
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 4px;
        z-index: 2;
    }

    .badge-tag.new {
        background: #ff3d00;
        right: 10px;
        left: auto;
    }

    .product-card-mini img {
        width: 100%;
        height: 160px;
        object-fit: contain;
        background: #f8fafc;
        border-radius: 6px;
        margin-bottom: 10px;
        transition: transform 0.3s ease;
    }

    .product-card-mini:hover img {
        transform: scale(1.04);
    }

    .mini-brand {
        font-size: 11px;
        color: #94a3b8;
        font-weight: 700;
        text-transform: uppercase;
        display: block;
    }

    .mini-title {
        font-size: 13px;
        font-weight: 700;
        color: #1e293b;
        margin: 4px 0 6px 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.3;
        height: 34px;
        transition: color 0.2s;
    }

    .mini-price {
        color: #ef4444;
        font-weight: 800;
        font-size: 14px;
        display: block;
        margin-bottom: 10px;
    }

    .product-card-mini .add-to-cart-btn {
        margin-top: 5px;
        padding: 8px 0;
        font-size: 12px;
        width: 100%;
        border-radius: 6px;
    }

    .btn-view-more {
        display: block;
        width: 140px;
        margin: 0 auto;
        text-align: center;
        padding: 8px 16px;
        border: 1px solid #0f172a;
        color: #0f172a;
        font-weight: 700;
        font-size: 12px;
        text-decoration: none;
        text-transform: uppercase;
        border-radius: 4px;
        transition: all 0.2s;
    }

    .btn-view-more:hover {
        background: #0f172a;
        color: #ffffff;
    }

    .sports-categories-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 15px;
        margin: 40px 0;
    }

    .sport-card {
        position: relative;
        height: 280px;
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        display: flex;
        align-items: flex-end;
        padding: 15px;
    }

    .sport-card img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .sport-card:hover img {
        transform: scale(1.08);
    }

    .sport-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
    }

    .sport-card span {
        position: relative;
        z-index: 2;
        color: #ffffff;
        font-weight: 900;
        font-size: 15px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .news-promo-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
        margin-top: 40px;
    }

    .news-block-title {
        background: #0f172a;
        color: #ffffff;
        padding: 8px 15px;
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

    .news-item {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        align-items: center;
    }

    .news-item img {
        width: 110px;
        height: 75px;
        object-fit: cover;
        border-radius: 6px;
    }

    .news-info h4 {
        font-size: 13px;
        font-weight: 700;
        margin: 0 0 5px 0;
        color: #1e293b;
    }

    .news-info p {
        font-size: 12px;
        color: #64748b;
        margin: 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @@media (max-width: 1024px) {
        .product-grid-5, .sports-categories-grid, .sub-banners-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @@media (max-width: 640px) {
        .product-grid-5, .sports-categories-grid, .sub-banners-grid, .news-promo-container {
            grid-template-columns: 1fr;
        }
    }
</style>

