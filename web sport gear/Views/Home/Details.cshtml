    }
}

<style>
    .details-wrapper {
        max-width: 1250px;
        margin: 30px auto 60px auto;
        padding: 0 20px;
    }

    .breadcrumb-nav {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 25px;
    }

        .breadcrumb-nav a {
            color: #0f172a;
            text-decoration: none;
            font-weight: 600;
        }

            .breadcrumb-nav a:hover {
                color: #ff5722;
            }

    .product-main-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-bottom: 50px;
    }

    .product-gallery-container {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .main-image-box {
        width: 100%;
        height: 460px;
        background: #f8fafc;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .main-image-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 20px;
        }

    .details-content {
        display: flex;
        flex-direction: column;
    }

    .brand-badge {
        font-size: 12px;
        font-weight: 800;
        color: #ff5722;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .product-title-heading {
        font-size: 26px;
        font-weight: 900;
        color: #0f172a;
        margin: 8px 0 12px 0;
        text-transform: uppercase;
    }

    .rating-summary {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .stars {
        color: #f59e0b;
    }

    .price-box {
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f1f5f9;
    }

    .current-price {
        font-size: 26px;
        font-weight: 900;
        color: #ef4444;
    }

    .old-price {
        font-size: 16px;
        color: #94a3b8;
        text-decoration: line-through;
    }

    .short-description {
        font-size: 14px;
        color: #475569;
        line-height: 1.6;
        margin-bottom: 25px;
    }

    .option-group {
        margin-bottom: 20px;
    }

    .option-title {
        font-size: 13px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .size-selector {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .size-chip {
        border: 1px solid #cbd5e1;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        background: #fff;
        transition: all 0.2s;
    }

        .size-chip:hover, .size-chip.selected {
            border-color: #ff5722;
            background: #ff5722;
            color: #fff;
        }

    .quantity-and-action {
        display: flex;
        gap: 15px;
        align-items: center;
        margin-top: 10px;
        margin-bottom: 30px;
    }

    .quantity-control {
        display: flex;
        align-items: center;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        overflow: hidden;
        height: 48px;
    }

    .qty-btn {
        background: #f8fafc;
        border: none;
        width: 40px;
        height: 100%;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        color: #334155;
    }

    .qty-input {
        width: 50px;
        height: 100%;
        border: none;
        text-align: center;
        font-weight: 700;
        font-size: 14px;
        color: #0f172a;
        outline: none;
    }

    .btn-buy-now {
        flex: 1;
        height: 48px;
        background: #0f172a;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-weight: 800;
        font-size: 14px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-buy-now:hover {
            background: #ff5722;
            transform: translateY(-2px);
        }

    .policy-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        background: #f8fafc;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid #f1f5f9;
    }

    .policy-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 600;
        color: #334155;
    }

        .policy-item i {
            color: #ff5722;
            font-size: 16px;
        }

    .product-tabs-container {
        margin-top: 50px;
        border-top: 2px solid #f1f5f9;
        padding-top: 30px;
    }

    .tab-headers {
        display: flex;
        gap: 30px;
        border-bottom: 2px solid #e2e8f0;
        margin-bottom: 30px;
    }

    .tab-title-btn {
        background: none;
        border: none;
        padding: 12px 0;
        font-size: 16px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        cursor: pointer;
        position: relative;
        bottom: -2px;
    }

        .tab-title-btn.active {
            color: #ff5722;
            border-bottom: 3px solid #ff5722;
        }

    .tab-panel {
        display: none;
        line-height: 1.7;
        color: #334155;
        font-size: 14px;
    }

        .tab-panel.active {
            display: block;
        }

    .reviews-summary-box {
        display: flex;
        gap: 40px;
        background: #f8fafc;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 30px;
        align-items: center;
    }

    .score-number {
        font-size: 42px;
        font-weight: 900;
        color: #0f172a;
    }

    .review-item {
        border-bottom: 1px solid #f1f5f9;
        padding: 20px 0;
    }

    .reviewer-meta {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .reviewer-name {
        font-weight: 700;
        color: #0f172a;
        font-size: 14px;
    }

    .add-review-form {
        margin-top: 30px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        padding: 20px;
        border-radius: 8px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 6px;
            color: #1e293b;
        }

    .form-control-custom {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
    }

    @@media (max-width: 768px) {
        .product-main-info {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="details-wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-nav">
        <a href="/">Trang Chủ</a> /
        <span>@category</span> /
        <span>@name</span>
    </div>

    <!-- MAIN PRODUCT INFO -->
    <div class="product-main-info">
        <!-- Gallery -->
        <div class="product-gallery-container">
            <div class="main-image-box">
                <img id="mainProductImg" src="@image" alt="@name" />
            </div>
        </div>

        <!-- Info Details -->
        <div class="details-content">
            <span class="brand-badge">@brand OFFICIAL</span>
            <h1 class="product-title-heading">@name</h1>

            <div class="rating-summary">
                <div class="stars">
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star"></i>
                    <i class="fa fa-star-half-alt"></i>
                </div>
                <span class="review-count-text">4.8/5 (24 đánh giá từ khách hàng)</span>
            </div>

            <div class="price-box">
                <span class="current-price">@price</span>
                <span class="old-price">@oldPrice</span>
            </div>

            <p class="short-description">@desc</p>

            <!-- Size Selector -->
            <div class="option-group">
                <div class="option-title">Chọn Kích Thước (Size):</div>
                <div class="size-selector">
                    <button type="button" class="size-chip selected">39</button>
                    <button type="button" class="size-chip">40</button>
                    <button type="button" class="size-chip">41</button>
                    <button type="button" class="size-chip">42</button>
                    <button type="button" class="size-chip">43</button>
                </div>
            </div>

            <!-- Quantity & Add Button -->
            <div class="option-title">Số Lượng:</div>
            <div class="quantity-and-action">
                <div class="quantity-control">
                    <button type="button" class="qty-btn" onclick="decreaseQty()">-</button>
                    <input type="text" id="productQty" class="qty-input" value="1" readonly />
                    <button type="button" class="qty-btn" onclick="increaseQty()">+</button>
                </div>

                <!-- Nút thêm vào giỏ hàng truyền đúng thông tin động theo sản phẩm -->
                <button type="button" class="btn-buy-now"
                        data-id="@productId"
                        data-name="@name"
                        data-price="@priceValue"
                        data-image="@image"
                        onclick="addCurrentProductToCart(this)">
                    <i class="fa fa-shopping-bag"></i> Thêm Vào Giỏ Hàng
                </button>
            </div>

            <!-- Policy Badges -->
            <div class="policy-grid">
                <div class="policy-item">
                    <i class="fa fa-truck"></i> Giao hàng toàn quốc từ 1-3 ngày
                </div>
                <div class="policy-item">
                    <i class="fa fa-sync-alt"></i> Đổi trả miễn phí trong 3 ngày
                </div>
                <div class="policy-item">
                    <i class="fa fa-shield-alt"></i> Bảo hành chính hãng 12 tháng
                </div>
                <div class="policy-item">
                    <i class="fa fa-check-circle"></i> Cam kết 100% Hàng chính hãng
                </div>
            </div>
        </div>
    </div>

    <!-- TABS: DESCRIPTION & REVIEWS -->
    <div class="product-tabs-container">
        <div class="tab-headers">
            <button class="tab-title-btn active" onclick="switchTab('descTab', this)">Mô Tả Sản Phẩm</button>
            <button class="tab-title-btn" onclick="switchTab('reviewTab', this)">Đánh Giá & Nhận Xét (24)</button>
        </div>

        <!-- Tab Content 1: Description -->
        <div id="descTab" class="tab-panel active">
            <h3 style="font-size: 18px; font-weight: 800; margin-bottom: 12px; color: #0f172a;">Chi Tiết Kỹ Thuật & Đặc Điểm</h3>
            <p>@desc</p>
            <ul style="padding-left: 20px; margin-top: 10px; line-height: 1.8;">
                <li><strong>Thương hiệu:</strong> @brand</li>
                <li><strong>Danh mục:</strong> @category</li>
                <li><strong>Chất liệu:</strong> @material</li>
                <li><strong>Trọng lượng:</strong> @weight</li>
                <li><strong>Xuất xứ:</strong> Chính hãng phân phối bởi Gear Sport</li>
            </ul>
        </div>

        <!-- Tab Content 2: Reviews -->
        <div id="reviewTab" class="tab-panel">
            <div class="reviews-summary-box">
                <div class="score-circle" style="text-align: center;">
                    <div class="score-number">4.8</div>
                    <div class="stars">
                        <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                    </div>
                </div>
                <div>
                    <h4 style="margin: 0 0 5px 0; font-size: 16px;">Đánh giá trung bình từ người mua</h4>
                    <p style="margin: 0; color: #64748b; font-size: 13px;">96% khách hàng hài lòng về sản phẩm này.</p>
                </div>
            </div>

            <div class="review-item">
                <div class="reviewer-meta">
                    <span class="reviewer-name">Nguyễn Văn Hùng <span style="color: #22c55e; font-size: 11px;">✓ Đã mua hàng</span></span>
                    <span class="review-date">12/10/2026</span>
                </div>
                <div class="stars" style="font-size: 12px; margin-bottom: 5px;">
                    <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                </div>
                <p style="margin: 0;">Sản phẩm cực kỳ chất lượng, đúng mô tả. Rất đáng tiền!</p>
            </div>

            <!-- Add Review Form -->
            <div class="add-review-form">
                <h4 style="margin-top: 0; margin-bottom: 15px; font-size: 15px; text-transform: uppercase;">Gửi Đánh Giá Của Bạn</h4>
                <div class="form-group">
                    <label>Họ và Tên:</label>
                    <input type="text" class="form-control-custom" placeholder="Nhập tên của bạn" />
                </div>
                <div class="form-group">
                    <label>Nội dung nhận xét:</label>
                    <textarea class="form-control-custom" rows="3" placeholder="Chia sẻ trải nghiệm sử dụng sản phẩm này..."></textarea>
                </div>
                <button type="button" class="btn-buy-now" style="width: auto; padding: 0 25px;">Gửi Đánh Giá</button>
            </div>
        </div>
    </div>
</div>

<script>
    function increaseQty() {
        let input = document.getElementById('productQty');
        let val = parseInt(input.value) || 1;
        input.value = val + 1;
    }

    function decreaseQty() {
        let input = document.getElementById('productQty');
        let val = parseInt(input.value) || 1;
        if (val > 1) {
            input.value = val - 1;
        }
    }

    function switchTab(tabId, btn) {
        document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));
        document.querySelectorAll('.tab-title-btn').forEach(b => b.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');
        btn.classList.add('active');
    }

    document.querySelectorAll('.size-chip').forEach(chip => {
        chip.addEventListener('click', function () {
            document.querySelectorAll('.size-chip').forEach(c => c.classList.remove('selected'));
            this.classList.add('selected');
        });
    });

    // Cập nhật hàm nhận thêm thuộc tính ảnh

    function addCurrentProductToCart(button) {
        const productId = button.getAttribute('data-id');
        const productName = button.getAttribute('data-name');
        const productPrice = parseFloat(button.getAttribute('data-price')) || 0;

        // Lấy ảnh từ nút; nếu thiếu thì lấy từ ảnh chính sản phẩm
        const imageElement = document.getElementById('mainProductImg');
        let productImage = button.getAttribute('data-image');

        if (!productImage || !productImage.trim()) {
            productImage = imageElement ? imageElement.src : '';
        }

        // Lấy số lượng người dùng chọn
        const qtyInput = document.getElementById('productQty');
        const quantity = qtyInput
            ? Math.max(1, parseInt(qtyInput.value, 10) || 1)
            : 1;

        // Đọc giỏ hàng hiện tại
        let cart = [];

        try {
            cart = JSON.parse(localStorage.getItem('cart')) || [];

            if (!Array.isArray(cart)) {
                cart = [];
            }
        } catch (error) {
            cart = [];
        }

        // Tìm sản phẩm đã có trong giỏ hàng
        const existingItem = cart.find(item => String(item.id) === String(productId));

        if (existingItem) {
            // Cộng số lượng
            existingItem.quantity = (parseInt(existingItem.quantity, 10) || 0) + quantity;

            // Sửa ảnh nếu dữ liệu cũ đang bị rỗng
            if (!existingItem.image || !existingItem.image.trim()) {
                existingItem.image = productImage;
            }

            // Bổ sung thông tin nếu dữ liệu cũ bị thiếu
            if (!existingItem.name) {
                existingItem.name = productName;
            }

            if (!existingItem.price) {
                existingItem.price = productPrice;
            }
        } else {
            // Thêm sản phẩm mới cùng đường dẫn ảnh
            cart.push({
                id: productId,
                name: productName,
                price: productPrice,
                image: productImage,
                quantity: quantity
            });
        }

        // Lưu giỏ hàng
        localStorage.setItem('cart', JSON.stringify(cart));

        // Cập nhật số lượng trên biểu tượng giỏ hàng
        const cartCountBadge = document.querySelector('.cart-count');

        if (cartCountBadge) {
            const totalQty = cart.reduce(
                (sum, item) => sum + (parseInt(item.quantity, 10) || 0),
                0
            );

            cartCountBadge.textContent = totalQty;
        }

        alert(`Đã thêm thành công ${quantity} sản phẩm "${productName}" vào giỏ hàng!`);
    }
    </script>