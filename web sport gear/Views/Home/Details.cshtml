    }
    else if (productId == 13)
    {
        name = "Áo Polo Thể Thao Nam Lịch Lãm";
        brand = "NIKE";
        price = "290.000 đ";
        priceValue = 290000;
        oldPrice = "390.000 đ";
        image = "https://plus.unsplash.com/premium_photo-1747861981617-1512bc2c06e8?w=500";
        desc = "Áo polo thể thao vừa lịch lãm để đi làm, vừa thoải mái năng động để chơi thể thao và tham gia hoạt động ngoài trời.";
        category = "Áo Polo";
