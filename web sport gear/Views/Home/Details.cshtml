@{
    ViewBag.Title = "Chi Tiết Sản Phẩm - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy ID từ Controller gửi sang (mặc định là 1 nếu null)
    int productId = ViewBag.ProductId != null ? (int)ViewBag.ProductId : 1;

    // Khởi tạo các thông tin mặc định theo ID sản phẩm
    string name = "Giày Thể Thao Chuyên Dụng Gear Sport Pro";
    string brand = "GEAR SPORT";
