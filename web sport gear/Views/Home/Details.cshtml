        brand = "MOLTEN";
        price = "650.000 đ";
        priceValue = 650000;
        oldPrice = "850.000 đ";
        image = "https://images.unsplash.com/photo-1518091043644-c1d4457512c6?w=500";
        desc = "Bóng đá thi đấu chuyên nghiệp đạt tiêu chuẩn chất lượng FIFA, độ nảy chuẩn xác và chống thấm nước tuyệt đối.";
        category = "Phụ Kiện Bóng Đá";
