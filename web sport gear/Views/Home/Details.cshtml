    string weight = "240g / chiếc";

    // Tùy chỉnh thông tin chi tiết dựa theo mã ID sản phẩm thực tế từ trang chủ
    if (productId == 1)
    {
        name = "Giày Tennis/Pickleball Nike Zoom Vapor 12";
