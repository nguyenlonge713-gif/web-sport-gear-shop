
@model web_sport_gear.Models.Product

@{
    ViewBag.Title = "Chi Tiết Sản Phẩm - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string imageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? "https://placehold.co/600x600?text=Gear+Sport"
        : Model.ImageUrl;

    string categoryName = string.IsNullOrWhiteSpace(Model.CategoryName)
        ? "Sản phẩm"
        : Model.CategoryName;

    // Danh sách hình ảnh sản phẩm
    var productImages = new List<string>
{
        imageUrl
    };

    // Tìm tối đa 4 ảnh bổ sung theo ProductID
    for (int i = 2; i <= 5; i++)
    {
        string imagePath = "~/Content/Images/Products/"
                         + Model.ProductID + "_" + i + ".jpg";

        string physicalPath = Server.MapPath(imagePath);

        if (System.IO.File.Exists(physicalPath))
        {
            productImages.Add(Url.Content(imagePath));
        }
    }

    // Lấy danh sách sản phẩm liên quan từ HomeController
    var relatedProducts =
        ViewBag.RelatedProducts as System.Collections.Generic.List<web_sport_gear.Models.Product>;
}

<style>
    .detail-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
        color: #222;
    }

    .breadcrumb {
        margin-bottom: 25px;
        color: #777;
        font-size: 14px;
    }

        .breadcrumb a {
            color: #777;
            text-decoration: none;
        }

            .breadcrumb a:hover {
                color: #ff5722;
            }

    .detail-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 45px;
        align-items: start;
    }

    /* =====================================
       THƯ VIỆN ẢNH
    ===================================== */

    .product-gallery {
        width: 100%;
    }

    .main-image-box {
        position: relative;
        width: 100%;
        background: #f7f7f7;
        border-radius: 12px;
        overflow: hidden;
    }

        .main-image-box img {
            display: block;
            width: 100%;
            height: 500px;
            object-fit: contain;
            padding: 20px;
            transition: opacity 0.2s ease;
        }

    .gallery-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
        color: #333;
        font-size: 24px;
        cursor: pointer;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        transition: 0.2s;
    }

        .gallery-arrow:hover {
            background: #ff5722;
            color: white;
        }

    .gallery-prev {
        left: 15px;
    }

    .gallery-next {
        right: 15px;
    }

    .thumbnail-list {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 15px;
        flex-wrap: wrap;
    }

    .thumbnail-item {
        width: 75px;
        height: 75px;
        border: 2px solid transparent;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        background: #f7f7f7;
        padding: 3px;
    }

        .thumbnail-item:hover {
            border-color: #ffb199;
        }

        .thumbnail-item.active {
            border-color: #ff5722;
        }

        .thumbnail-item img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .gallery-counter {
        text-align: center;
        color: #777;
        font-size: 13px;
        margin-top: 10px;
    }

    /* =====================================
       THÔNG TIN SẢN PHẨM
    ===================================== */

    .product-info {
        padding: 10px 0;
    }

    .category-label {
        display: inline-block;
        background: #fff0e9;
        color: #ff5722;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        margin-bottom: 15px;
    }

    .product-title-heading {
        font-size: 30px;
        font-weight: 700;
        line-height: 1.4;
        margin: 0 0 15px;
    }

    .product-rating {
        color: #f5a623;
        margin-bottom: 20px;
        font-size: 14px;
    }

        .product-rating span {
            color: #777;
            margin-left: 8px;
        }

    .price-box {
        margin: 20px 0;
        padding: 18px 0;
        border-top: 1px solid #eee;
        border-bottom: 1px solid #eee;
    }

    .current-price {
        font-size: 30px;
        color: #e53935;
        font-weight: 700;
    }

    .product-description {
        color: #666;
        line-height: 1.8;
        margin: 20px 0;
        white-space: pre-line;
    }

    .stock-status {
        margin: 15px 0;
        font-size: 14px;
    }

    .stock-in {
        color: #219653;
        font-weight: 600;
    }

    .stock-out {
        color: #e53935;
        font-weight: 600;
    }

    /* =====================================
       SỐ LƯỢNG
    ===================================== */

    .quantity-area {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 25px 0;
    }

        .quantity-area label {
            font-weight: 600;
        }

    .quantity-control {
        display: flex;
        align-items: center;
        border: 1px solid #ddd;
        border-radius: 6px;
        overflow: hidden;
    }

        .quantity-control button {
            width: 38px;
            height: 38px;
            border: none;
            background: #f5f5f5;
            cursor: pointer;
            font-size: 18px;
        }

            .quantity-control button:hover {
                background: #e8e8e8;
            }

        .quantity-control input {
            width: 65px;
            height: 38px;
            border: none;
            text-align: center;
            font-size: 15px;
            outline: none;
        }

    /* =====================================
       NÚT MUA HÀNG
    ===================================== */

    .detail-actions {
        display: flex;
        gap: 12px;
        margin-top: 25px;
    }

    .btn-buy-now {
        flex: 1;
        min-height: 48px;
        border: none;
        border-radius: 6px;
        background: #ff5722;
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-buy-now:hover {
            background: #e64a19;
        }

        .btn-buy-now:disabled {
            background: #999;
            cursor: not-allowed;
        }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
        min-height: 48px;
        border: 1px solid #ddd;
        border-radius: 6px;
        color: #333;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #f5f5f5;
        }

    /* =====================================
       TAB THÔNG TIN
    ===================================== */

    .product-tabs {
        margin-top: 60px;
    }

    .tab-buttons {
        display: flex;
        gap: 30px;
        border-bottom: 1px solid #ddd;
        margin-bottom: 25px;
    }

    .tab-button {
        padding: 12px 5px;
        border: none;
        border-bottom: 3px solid transparent;
        background: none;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        color: #777;
    }

        .tab-button.active {
            color: #ff5722;
            border-bottom-color: #ff5722;
        }

    .tab-content {
        display: none;
        color: #555;
        line-height: 1.8;
        white-space: pre-line;
    }

        .tab-content.active {
            display: block;
        }

    .info-table {
        width: 100%;
        max-width: 650px;
        border-collapse: collapse;
    }

        .info-table td {
            padding: 12px;
            border-bottom: 1px solid #eee;
        }

            .info-table td:first-child {
                width: 180px;
                font-weight: 600;
                color: #333;
            }

    /* =====================================
       SẢN PHẨM LIÊN QUAN
    ===================================== */

    .related-products {
        margin-top: 55px;
        padding-top: 30px;
        border-top: 1px solid #eee;
    }

    .related-heading {
        font-size: 25px;
        font-weight: 700;
        color: #222;
        margin-bottom: 25px;
        position: relative;
        padding-left: 14px;
    }

        .related-heading::before {
            content: "";
            position: absolute;
            left: 0;
            top: 4px;
            bottom: 4px;
            width: 4px;
            background: #ff5722;
            border-radius: 4px;
        }

    .related-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
    }

    .related-card {
        display: block;
        text-decoration: none;
        color: #222;
        border: 1px solid #eee;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        transition: 0.25s ease;
    }

        .related-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.09);
            border-color: #ffb199;
            color: #222;
        }

    .related-image {
        width: 100%;
        height: 220px;
        background: #f7f7f7;
        overflow: hidden;
    }

        .related-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 12px;
            transition: transform 0.3s ease;
        }

    .related-card:hover .related-image img {
        transform: scale(1.06);
    }

    .related-info {
        padding: 15px;
    }

    .related-name {
        font-size: 15px;
        font-weight: 600;
        line-height: 1.5;
        height: 45px;
        overflow: hidden;
        margin-bottom: 10px;
    }

    .related-price {
        font-size: 18px;
        font-weight: 700;
        color: #e53935;
    }

    .related-link {
        display: inline-block;
        margin-top: 10px;
        font-size: 13px;
        color: #ff5722;
        font-weight: 600;
    }

    /* =====================================
       RESPONSIVE
    ===================================== */

    @@media (max-width: 900px) {
        .related-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .detail-layout {
            grid-template-columns: 1fr;
            gap: 25px;
        }

        .main-image-box img {
            height: 350px;
        }

        .product-title-heading {
            font-size: 24px;
        }

        .current-price {
            font-size: 25px;
        }

        .detail-actions {
            flex-direction: column;
        }

        .btn-back {
            min-height: 45px;
        }

        .gallery-arrow {
            width: 36px;
            height: 36px;
        }

        .thumbnail-item {
            width: 60px;
            height: 60px;
        }
    }

    @@media (max-width: 480px) {
        .related-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .related-image {
            height: 155px;
        }

        .related-info {
            padding: 10px;
        }

        .related-name {
            font-size: 13px;
        }

        .related-price {
            font-size: 16px;
        }

        .related-heading {
            font-size: 21px;
        }
    }
</style>

<div class="detail-container">

    <div class="breadcrumb">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
        <span> / </span>
        <span>@categoryName</span>
        <span> / </span>
        <strong>@Model.ProductName</strong>
    </div>

    <div class="detail-layout">

        <!-- =====================================
             THƯ VIỆN HÌNH ẢNH SẢN PHẨM
        ====================================== -->

        <div class="product-gallery">

            <div class="main-image-box">

                <img id="mainProductImg"
                     src="@imageUrl"
                     alt="@Model.ProductName"
                     onerror="this.onerror=null; this.src='https://placehold.co/600x600?text=No+Image';" />

                <button type="button"
                        class="gallery-arrow gallery-prev"
                        id="btnPrevImage"
                        aria-label="Ảnh trước">
                    &#10094;
                </button>

                <button type="button"
                        class="gallery-arrow gallery-next"
                        id="btnNextImage"
                        aria-label="Ảnh tiếp theo">
                    &#10095;
                </button>

            </div>

            <div class="thumbnail-list" id="thumbnailList"></div>

            <div class="gallery-counter" id="galleryCounter"></div>

        </div>

        <!-- =====================================
             THÔNG TIN SẢN PHẨM
        ====================================== -->

        <div class="product-info">

            <span class="category-label">
                @categoryName
            </span>

            <h1 class="product-title-heading">
                @Model.ProductName
            </h1>

            <div class="product-rating">
                ★★★★★
                <span>Đánh giá sản phẩm</span>
            </div>

            <div class="price-box">
                <div class="current-price">
                    @Model.Price.ToString("N0") đ
                </div>
            </div>

            <div class="product-description">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <span>Thông tin chi tiết sản phẩm đang được cập nhật.</span>
                }
                else
                {
                    @Model.Description
                }
            </div>

            <div class="stock-status">
                Tình trạng:

                @if (Model.IsActive && Model.StockQuantity > 0)
                {
                    <span class="stock-in">
                        Còn hàng (@Model.StockQuantity sản phẩm)
                    </span>
                }
                else
                {
                    <span class="stock-out">
                        Tạm hết hàng
                    </span>
                }
            </div>

            <div class="quantity-area">

                <label for="productQuantity">Số lượng:</label>

                <div class="quantity-control">

                    <button type="button" id="btnDecrease">−</button>

                    <input type="number"
                           id="productQuantity"
                           value="1"
                           min="1"
                           max="@(Model.StockQuantity > 0 ? Model.StockQuantity : 1)"
                           step="1"
                           aria-label="Số lượng sản phẩm" />

                    <button type="button" id="btnIncrease">+</button>

                </div>

            </div>

            <div class="detail-actions">

                <!-- NÚT THÊM VÀO GIỎ HÀNG -->
                <button type="button"
                        class="btn-buy-now add-to-cart-btn"
                        data-id="@Model.ProductID"
                        data-name="@Model.ProductName"
                        data-price="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        data-image="@imageUrl"
                        data-stock="@Model.StockQuantity"
                        @(Model.IsActive && Model.StockQuantity > 0 ? "" : "disabled")>

                    <i class="fa fa-shopping-bag"></i>
                    Thêm vào giỏ hàng

                </button>

                <a href="javascript:history.back()" class="btn-back">
                    Quay lại
                </a>

            </div>

        </div>

    </div>

    <!-- =====================================
         CÁC TAB THÔNG TIN
    ====================================== -->

    <div class="product-tabs">

        <div class="tab-buttons">

            <button type="button"
                    class="tab-button active"
                    data-tab="descriptionTab">
                Mô tả sản phẩm
            </button>

            <button type="button"
                    class="tab-button"
                    data-tab="informationTab">
                Thông tin sản phẩm
            </button>

        </div>

        <div id="descriptionTab" class="tab-content active">

            <h3>Chi tiết sản phẩm</h3>

            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <p>Thông tin mô tả sản phẩm đang được cập nhật.</p>
            }
            else
            {
                <p>@Model.Description</p>
            }

        </div>

        <div id="informationTab" class="tab-content">

            <h3>Thông tin sản phẩm</h3>

            <table class="info-table">

                <tr>
                    <td>Mã sản phẩm</td>
                    <td>@Model.ProductID</td>
                </tr>

                <tr>
                    <td>Tên sản phẩm</td>
                    <td>@Model.ProductName</td>
                </tr>

                <tr>
                    <td>Danh mục</td>
                    <td>@categoryName</td>
                </tr>

                <tr>
                    <td>Giá bán</td>
                    <td>@Model.Price.ToString("N0") đ</td>
                </tr>

                <tr>
                    <td>Số lượng tồn kho</td>
                    <td>@Model.StockQuantity</td>
                </tr>

                <tr>
                    <td>Trạng thái</td>
                    <td>
                        @(Model.IsActive ? "Đang kinh doanh" : "Ngừng kinh doanh")
                    </td>
                </tr>

            </table>

        </div>

    </div>

    <!-- =====================================
         SẢN PHẨM LIÊN QUAN
         Hiển thị tối đa 4 sản phẩm cùng danh mục
    ====================================== -->

    @if (relatedProducts != null && relatedProducts.Count > 0)
    {
        <div class="related-products">

            <h2 class="related-heading">
                Sản phẩm liên quan
            </h2>

            <div class="related-grid">

                @foreach (var item in relatedProducts)
                {
                    string relatedImage = string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? "https://placehold.co/400x400?text=Gear+Sport"
                        : item.ImageUrl;

                    <a href="@Url.Action("Details", "Home", new { id = item.ProductID })"
                       class="related-card">

                        <div class="related-image">

                            <img src="@relatedImage"
                                 alt="@item.ProductName"
                                 onerror="this.onerror=null; this.src='https://placehold.co/400x400?text=No+Image';" />

                        </div>

                        <div class="related-info">

                            <div class="related-name">
                                @item.ProductName
                            </div>

                            <div class="related-price">
                                @item.Price.ToString("N0") đ
                            </div>

                            <span class="related-link">
                                Xem chi tiết →
                            </span>

                        </div>

                    </a>
                }

            </div>

        </div>
    }

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================
        // 1. THƯ VIỆN ẢNH SẢN PHẨM
        // =====================================

        const productImages = @Html.Raw(
            System.Web.Helpers.Json.Encode(productImages)
        );

        const mainProductImg = document.getElementById("mainProductImg");
        const thumbnailList = document.getElementById("thumbnailList");
        const prevButton = document.getElementById("btnPrevImage");
        const nextButton = document.getElementById("btnNextImage");
        const galleryCounter = document.getElementById("galleryCounter");

        let currentImageIndex = 0;

        function showProductImage(index) {

            if (!productImages || productImages.length === 0) {
                return;
            }

            if (index < 0) {
                index = productImages.length - 1;
            }

            if (index >= productImages.length) {
                index = 0;
            }

            currentImageIndex = index;

            mainProductImg.src = productImages[currentImageIndex];

            const thumbnails = document.querySelectorAll(".thumbnail-item");

            thumbnails.forEach(function (thumbnail, i) {
                thumbnail.classList.toggle(
                    "active",
                    i === currentImageIndex
                );
            });

            galleryCounter.textContent =
                "Ảnh " + (currentImageIndex + 1)
                + " / " + productImages.length;
        }

        // Tạo ảnh thu nhỏ
        productImages.forEach(function (image, index) {

            const thumbnail = document.createElement("button");

            thumbnail.type = "button";
            thumbnail.className = "thumbnail-item";

            if (index === 0) {
                thumbnail.classList.add("active");
            }

            const thumbnailImg = document.createElement("img");

            thumbnailImg.src = image;
            thumbnailImg.alt = "Ảnh sản phẩm " + (index + 1);

            thumbnailImg.onerror = function () {
                thumbnail.style.display = "none";
            };

            thumbnail.appendChild(thumbnailImg);

            thumbnail.addEventListener("click", function () {
                showProductImage(index);
            });

            thumbnailList.appendChild(thumbnail);

        });

        // Nút ảnh trước
        prevButton.addEventListener("click", function () {
            showProductImage(currentImageIndex - 1);
        });

        // Nút ảnh tiếp theo
        nextButton.addEventListener("click", function () {
            showProductImage(currentImageIndex + 1);
        });

        // Ẩn nút chuyển ảnh nếu chỉ có một ảnh
        if (productImages.length <= 1) {

            prevButton.style.display = "none";
            nextButton.style.display = "none";
            galleryCounter.style.display = "none";

        } else {

            showProductImage(0);

        }

        // =====================================
        // 2. TĂNG GIẢM VÀ NHẬP SỐ LƯỢNG
        // =====================================

        const quantityInput = document.getElementById("productQuantity");
        const decreaseButton = document.getElementById("btnDecrease");
        const increaseButton = document.getElementById("btnIncrease");

        const minQuantity = 1;
        const maxQuantity = parseInt(quantityInput.max, 10) || 1;

        // Chuẩn hóa số lượng
        function normalizeQuantity() {

            let quantity = Number(quantityInput.value);

            if (!Number.isInteger(quantity)) {
                quantity = minQuantity;
            }

            if (quantity < minQuantity) {
                quantity = minQuantity;
            }

            if (quantity > maxQuantity) {
                quantity = maxQuantity;
            }

            quantityInput.value = quantity;

            return quantity;
        }

        // Giảm số lượng
        decreaseButton.addEventListener("click", function () {

            let quantity = Number(quantityInput.value);

            if (!Number.isInteger(quantity)) {
                quantity = minQuantity;
            }

            if (quantity > minQuantity) {
                quantityInput.value = quantity - 1;
            }

        });

        // Tăng số lượng
        increaseButton.addEventListener("click", function () {

            let quantity = Number(quantityInput.value);

            if (!Number.isInteger(quantity)) {
                quantity = minQuantity;
            }

            if (quantity < maxQuantity) {
                quantityInput.value = quantity + 1;
            }

        });

        // Chuẩn hóa khi người dùng thay đổi giá trị
        quantityInput.addEventListener("change", normalizeQuantity);

        // Chuẩn hóa khi người dùng rời khỏi ô nhập
        quantityInput.addEventListener("blur", normalizeQuantity);

        // =====================================
        // 3. CHUYỂN TAB THÔNG TIN
        // =====================================

        const tabButtons = document.querySelectorAll(".tab-button");
        const tabContents = document.querySelectorAll(".tab-content");

        tabButtons.forEach(function (button) {

            button.addEventListener("click", function () {

                tabButtons.forEach(function (item) {
                    item.classList.remove("active");
                });

                tabContents.forEach(function (content) {
                    content.classList.remove("active");
                });

                button.classList.add("active");

                const targetTab = document.getElementById(
                    button.getAttribute("data-tab")
                );

                if (targetTab) {
                    targetTab.classList.add("active");
                }

            });

        });

    });
</script>
