    }
    else if (productId == 6)
    {
        name = "Găng Tay Thủ Môn Dính Xương";
        brand = "PRO GOAL";
        price = "450.000 đ";
        priceValue = 450000;
        oldPrice = "600.000 đ";
        image = "https://plus.unsplash.com/premium_photo-1781205755096-6caab3faf2a1?w=500";
        desc = "Găng tay thủ môn tích hợp khung xương bảo vệ ngón tay chống lật, mặt mút cao su Đức bắt dính bóng cực tốt.";
        category = "Phụ Kiện Thủ Môn";
