
@model web_sport_gear.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==============================
       CHANGE PASSWORD - GEAR SPORT
       ============================== */

    .gs-password-page {
        min-height: 80vh;
        padding: 55px 15px 75px;
        background: linear-gradient(135deg, #eef4ff 0%, #f7f9fd 55%, #edf2fa 100%);
    }

    .gs-password-container {
        max-width: 850px;
        margin: 0 auto;
    }

    /* Header */

    .gs-password-header {
        text-align: center;
        margin-bottom: 32px;
    }

        .gs-password-header .header-label {
            display: inline-block;
            padding: 7px 15px;
            margin-bottom: 13px;
            border-radius: 30px;
            background: #dbeafe;
            color: #1d4ed8;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .gs-password-header h2 {
            color: #142b4a;
            font-size: 30px;
            font-weight: 900;
            letter-spacing: 1px;
            margin: 0 0 12px;
        }

        .gs-password-header p {
            color: #718096;
            font-size: 14px;
            margin: 0;
        }

    /* Main card */

    .gs-password-card {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(24, 48, 84, 0.10);
        border: 1px solid #e5ebf5;
    }

    /* Left panel */

    .gs-password-sidebar {
        position: relative;
        padding: 38px 27px;
        color: #fff;
        background: linear-gradient(155deg, #102b50 0%, #17477d 100%);
        overflow: hidden;
    }

        .gs-password-sidebar::before {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.10);
            top: -100px;
            right: -100px;
        }

        .gs-password-sidebar::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.08);
            bottom: -80px;
            left: -80px;
        }

    .gs-sidebar-content {
        position: relative;
        z-index: 1;
    }

    .gs-security-icon {
        width: 76px;
        height: 76px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 20px;
        background: rgba(255,255,255,0.13);
        border: 1px solid rgba(255,255,255,0.18);
        color: #ffb547;
        font-size: 34px;
        margin-bottom: 27px;
    }

    .gs-password-sidebar h3 {
        font-size: 21px;
        line-height: 1.45;
        font-weight: 800;
        margin: 0 0 13px;
        color: #fff;
    }

    .gs-password-sidebar p {
        font-size: 13px;
        line-height: 1.8;
        color: #cbd8e9;
        margin-bottom: 28px;
    }

    .gs-security-benefit {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 18px;
        font-size: 12px;
        line-height: 1.6;
        color: #e3edf9;
    }

        .gs-security-benefit i {
            color: #4ade80;
            font-size: 15px;
            margin-top: 2px;
        }

    .gs-sidebar-footer {
        margin-top: 35px;
        padding-top: 18px;
        border-top: 1px solid rgba(255,255,255,0.16);
        color: #a9bdd5;
        font-size: 11px;
        letter-spacing: 1px;
        font-weight: 700;
    }

    /* Right form panel */

    .gs-password-content {
        padding: 38px 38px 32px;
        min-width: 0;
    }

    .gs-form-heading {
        margin-bottom: 27px;
    }

        .gs-form-heading h3 {
            color: #172f50;
            font-size: 21px;
            font-weight: 800;
            margin: 0 0 8px;
        }

        .gs-form-heading p {
            color: #8491a3;
            font-size: 13px;
            margin: 0;
        }

    /* Alerts */

    .gs-password-alert {
        padding: 13px 15px;
        border-radius: 9px;
        margin-bottom: 20px;
        font-size: 13px;
        line-height: 1.6;
    }

        .gs-password-alert.success {
            color: #087443;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
        }

        .gs-password-alert.error {
            color: #b91c1c;
            background: #fef2f2;
            border: 1px solid #fecaca;
        }

        .gs-password-alert i {
            margin-right: 7px;
        }

    .validation-summary-errors {
        color: #b91c1c;
        background: #fff1f2;
        border: 1px solid #fecdd3;
        padding: 13px 16px;
        border-radius: 9px;
        margin-bottom: 22px;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

    /* Form fields */

    .gs-password-form .form-group {
        margin-bottom: 21px;
    }

    .gs-password-form label {
        display: block;
        color: #33445c;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .gs-required {
        color: #ef4444;
    }

    .gs-password-input {
        position: relative;
    }

        .gs-password-input input {
            width: 100%;
            height: 49px;
            padding: 10px 48px 10px 43px;
            border: 1px solid #dce4ef;
            border-radius: 9px;
            background: #fbfcfe;
            color: #24364b;
            font-size: 13px;
            box-shadow: none;
            transition: all 0.2s ease;
        }

            .gs-password-input input:focus {
                background: #fff;
                border-color: #3275d5;
                outline: none;
                box-shadow: 0 0 0 3px rgba(50,117,213,0.11);
            }

    .gs-input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #8b9bb0;
        font-size: 15px;
        pointer-events: none;
    }

    .gs-toggle-password {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        width: 32px;
        height: 32px;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0;
        border: none;
        background: transparent;
        color: #8997a9;
        cursor: pointer;
        font-size: 16px;
        transition: color 0.2s ease;
    }

        .gs-toggle-password:hover {
            color: #2563eb;
        }

        .gs-toggle-password:focus {
            outline: none;
        }

    .gs-password-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
    }

    /* Password hint */

    .gs-password-hint {
        padding: 13px 15px;
        margin: 5px 0 23px;
        background: #f0f6ff;
        border: 1px solid #dbeafe;
        border-radius: 9px;
    }

    .gs-password-hint-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #24599b;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .gs-password-hint p {
        color: #64748b;
        font-size: 12px;
        line-height: 1.7;
        margin: 0;
    }

    /* Action buttons */

    .gs-password-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 27px;
    }

    .gs-btn-save {
        min-height: 46px;
        padding: 12px 22px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        background: linear-gradient(135deg, #2563eb, #174ea6);
        color: #fff;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 5px 13px rgba(37,99,235,0.20);
        transition: all 0.2s ease;
    }

        .gs-btn-save:hover {
            background: linear-gradient(135deg, #1d4ed8, #123d83);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(37,99,235,0.25);
        }

    .gs-btn-back {
        min-height: 46px;
        padding: 12px 21px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .gs-btn-back:hover {
            background: #e2e8f0;
            color: #1e293b;
            text-decoration: none;
        }

    /* Bottom note */

    .gs-password-footer {
        text-align: center;
        margin-top: 24px;
        color: #9aa7b8;
        font-size: 11px;
    }

        .gs-password-footer i {
            color: #16a34a;
            margin-right: 5px;
        }

    /* Responsive */

    @@media (max-width: 767px) {
        .gs-password-page {
            padding: 35px 12px 50px;
        }

        .gs-password-card {
            grid-template-columns: 1fr;
        }

        .gs-password-sidebar {
            padding: 25px;
        }

        .gs-security-icon {
            width: 60px;
            height: 60px;
            font-size: 27px;
            border-radius: 16px;
            margin-bottom: 17px;
        }

        .gs-password-sidebar h3 {
            font-size: 19px;
        }

        .gs-password-sidebar p {
            margin-bottom: 18px;
        }

        .gs-security-benefit {
            margin-bottom: 11px;
        }

        .gs-sidebar-footer {
            margin-top: 20px;
        }

        .gs-password-content {
            padding: 27px 22px;
        }

        .gs-password-header h2 {
            font-size: 25px;
        }
    }

    @@media (max-width: 420px) {
        .gs-password-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .gs-btn-save,
        .gs-btn-back {
            width: 100%;
        }
    }
</style>

<div class="gs-password-page">
    <div class="gs-password-container">

        <!-- PAGE HEADER -->
        <div class="gs-password-header">
            <div class="header-label">
                GEAR SPORT ACCOUNT
            </div>

            <h2>ĐỔI MẬT KHẨU</h2>

            <p>
                Quản lý bảo mật và bảo vệ tài khoản Gear Sport của bạn.
            </p>
        </div>

        <!-- MAIN CARD -->
        <div class="gs-password-card">

            <!-- LEFT SECURITY PANEL -->
            <div class="gs-password-sidebar">
                <div class="gs-sidebar-content">

                    

                    <h3>Bảo vệ tài khoản của bạn</h3>

                    <p>
                        Một mật khẩu mạnh giúp bảo vệ thông tin cá nhân
                        và lịch sử mua sắm của bạn an toàn hơn.
                    </p>

                    <div class="gs-security-benefit">
                        <i class="glyphicon glyphicon-ok-circle"></i>
                        <span>Sử dụng mật khẩu riêng cho tài khoản Gear Sport.</span>
                    </div>

                    <div class="gs-security-benefit">
                        <i class="glyphicon glyphicon-ok-circle"></i>
                        <span>Không chia sẻ mật khẩu với người khác.</span>
                    </div>

                    <div class="gs-security-benefit">
                        <i class="glyphicon glyphicon-ok-circle"></i>
                        <span>Thay đổi mật khẩu khi nghi ngờ tài khoản bị lộ.</span>
                    </div>

                    <div class="gs-sidebar-footer">
                        GEAR SPORT · ACCOUNT SECURITY
                    </div>

                </div>
            </div>

            <!-- RIGHT FORM PANEL -->
            <div class="gs-password-content">

                <div class="gs-form-heading">
                    <h3>Thiết lập mật khẩu mới</h3>
                    <p>Vui lòng điền đầy đủ thông tin bên dưới.</p>
                </div>

                @if (TempData["PasswordSuccess"] != null)
                {
                    <div class="gs-password-alert success">
                        <i class="glyphicon glyphicon-ok-circle"></i>
                        <strong>Thành công!</strong>
                        @TempData["PasswordSuccess"]
                    </div>
                }

                @using (Html.BeginForm(
                    "ChangePassword",
                    "Account",
                    FormMethod.Post,
                    new { @class = "gs-password-form" }))
                {
                    @Html.AntiForgeryToken()


                    <!-- CURRENT PASSWORD -->
                    <div class="form-group">
                        <label for="CurrentPassword">
                            Mật khẩu hiện tại <span class="gs-required">*</span>
                        </label>

                        <div class="gs-password-input">
                            <i class="glyphicon glyphicon-lock gs-input-icon"></i>

                            @Html.PasswordFor(
                                model => model.CurrentPassword,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Nhập mật khẩu hiện tại",
                                    id = "CurrentPassword",
                                    autocomplete = "current-password"
                                })

                            <button type="button"
                                    class="gs-toggle-password"
                                    aria-label="Hiện hoặc ẩn mật khẩu"
                                    onclick="togglePassword('CurrentPassword', this)">
                                <i class="fa-regular fa-eye-slash"></i>
                            </button>
                        </div>

                        @Html.ValidationMessageFor(
                            model => model.CurrentPassword,
                            "",
                            new { @class = "gs-password-error" })
                    </div>

                    <!-- NEW PASSWORD -->
                    <div class="form-group">
                        <label for="NewPassword">
                            Mật khẩu mới <span class="gs-required">*</span>
                        </label>

                        <div class="gs-password-input">
                            <i class="glyphicon glyphicon-key gs-input-icon"></i>

                            @Html.PasswordFor(
                                model => model.NewPassword,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Nhập mật khẩu mới",
                                    id = "NewPassword",
                                    autocomplete = "new-password"
                                })

                            <button type="button"
                                    class="gs-toggle-password"
                                    aria-label="Hiện hoặc ẩn mật khẩu"
                                    onclick="togglePassword('NewPassword', this)">
                                <i class="fa-regular fa-eye-slash"></i>
                            </button>
                        </div>

                        @Html.ValidationMessageFor(
                            model => model.NewPassword,
                            "",
                            new { @class = "gs-password-error" })
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="form-group">
                        <label for="ConfirmPassword">
                            Xác nhận mật khẩu mới <span class="gs-required">*</span>
                        </label>

                        <div class="gs-password-input">
                            <i class="glyphicon glyphicon-check gs-input-icon"></i>

                            @Html.PasswordFor(
                                model => model.ConfirmPassword,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Nhập lại mật khẩu mới",
                                    id = "ConfirmPassword",
                                    autocomplete = "new-password"
                                })

                            <button type="button"
                                    class="gs-toggle-password"
                                    aria-label="Hiện hoặc ẩn mật khẩu"
                                    onclick="togglePassword('ConfirmPassword', this)">
                                <i class="fa-regular fa-eye-slash"></i>
                            </button>
                        </div>

                        @Html.ValidationMessageFor(
                            model => model.ConfirmPassword,
                            "",
                            new { @class = "gs-password-error" })
                    </div>

                    <!-- PASSWORD REQUIREMENT -->
                    <div class="gs-password-hint">
                        <div class="gs-password-hint-title">
                            <i class="glyphicon glyphicon-info-sign"></i>
                            YÊU CẦU MẬT KHẨU
                        </div>

                        <p>
                            Mật khẩu mới phải có ít nhất 8 ký tự.
                            Nên kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt
                            để tăng độ bảo mật.
                        </p>
                    </div>

                    <!-- ACTIONS -->
                    <div class="gs-password-actions">

                        <button type="submit" class="gs-btn-save">
                            <i class="glyphicon glyphicon-floppy-disk"></i>
                            Đổi mật khẩu
                        </button>

                        <a href="@Url.Action("Profile", "Account")"
                           class="gs-btn-back">
                            <i class="glyphicon glyphicon-arrow-left"></i>
                            Quay lại hồ sơ
                        </a>

                    </div>
                }

                <div class="gs-password-footer">
                    <i class="glyphicon glyphicon-lock"></i>
                    Thông tin mật khẩu của bạn được bảo vệ an toàn.
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword(inputId, button) {
        var input = document.getElementById(inputId);
        var icon = button.querySelector("i");

        if (!input || !icon) {
            return;
        }

        if (input.type === "password") {
            input.type = "text";
            icon.className = "fa-regular fa-eye";
            button.setAttribute("aria-label", "Ẩn mật khẩu");
        }
        else {
            input.type = "password";
            icon.className = "fa-regular fa-eye-slash";
            button.setAttribute("aria-label", "Hiện mật khẩu");
        }
    }
</script>
