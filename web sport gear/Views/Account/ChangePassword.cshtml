
@model web_sport_gear.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu - Gear Sport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .password-page {
        background: #f5f5f5;
        min-height: 75vh;
        padding: 50px 15px 70px;
    }

    .password-container {
        max-width: 650px;
        margin: auto;
    }

    .password-heading {
        margin-bottom: 25px;
    }

        .password-heading h2 {
            font-size: 28px;
            font-weight: 800;
            color: #171717;
        }

        .password-heading p {
            color: #777;
            font-size: 14px;
        }

    .password-card {
        background: #fff;
        border-radius: 12px;
        padding: 35px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.06);
    }

    .password-icon {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: #fff0f0;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        margin-bottom: 20px;
    }

    .password-card h3 {
        font-size: 21px;
        font-weight: 800;
        margin-bottom: 8px;
        color: #222;
    }

    .password-description {
        font-size: 13px;
        color: #888;
        margin-bottom: 25px;
    }

    .password-form .form-group {
        margin-bottom: 22px;
    }

    .password-form label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
        color: #444;
    }

    .password-input-wrapper {
        position: relative;
    }

        .password-input-wrapper input {
            width: 100%;
            height: 46px;
            padding: 10px 45px 10px 13px;
            border: 1px solid #ddd;
            border-radius: 7px;
            box-shadow: none;
            font-size: 14px;
        }

            .password-input-wrapper input:focus {
                border-color: #dc2626;
                outline: none;
                box-shadow: 0 0 0 2px rgba(220,38,38,0.08);
            }

    .toggle-password {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #888;
        cursor: pointer;
        font-size: 16px;
    }

        .toggle-password:hover {
            color: #dc2626;
        }

    .password-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
    }

    .validation-summary-errors {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
        padding: 12px 15px;
        border-radius: 7px;
        margin-bottom: 20px;
        font-size: 13px;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

    .password-alert {
        padding: 13px 16px;
        border-radius: 7px;
        margin-bottom: 20px;
        font-size: 14px;
    }

        .password-alert.success {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
        }

        .password-alert.error {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

    .password-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
    }

    .btn-password-save {
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 12px 24px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-password-save:hover {
            background: #b91c1c;
        }

    .btn-password-cancel {
        display: inline-block;
        background: #eee;
        color: #444;
        border-radius: 7px;
        padding: 12px 24px;
        text-decoration: none;
        font-size: 14px;
    }

        .btn-password-cancel:hover {
            background: #ddd;
            color: #222;
            text-decoration: none;
        }

    .password-note {
        margin-top: 22px;
        padding: 14px;
        background: #f8f8f8;
        border-radius: 7px;
        color: #777;
        font-size: 12px;
        line-height: 1.7;
    }

    @@media (max-width: 600px) {
        .password-card {
            padding: 23px 18px;
        }

        .password-heading h2 {
            font-size: 24px;
        }
    }
</style>

<div class="password-page">
    <div class="password-container">

        <div class="password-heading">
            <h2>ĐỔI MẬT KHẨU</h2>
            <p>Bảo vệ tài khoản và thông tin cá nhân của bạn.</p>
        </div>

        <div class="password-card">

            <div class="password-icon">
                <i class="glyphicon glyphicon-lock"></i>
            </div>

            <h3>Thiết lập mật khẩu mới</h3>

            <p class="password-description">
                Vui lòng nhập mật khẩu hiện tại và mật khẩu mới của bạn.
            </p>

            @if (TempData["PasswordSuccess"] != null)
            {
                <div class="password-alert success">
                    <strong>Thành công!</strong>
                    @TempData["PasswordSuccess"]
                </div>
            }

            @using (Html.BeginForm(
                "ChangePassword",
                "Account",
                FormMethod.Post,
                new { @class = "password-form" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    false,
                    "",
                    new { @class = "validation-summary-errors" })

                <div class="form-group">
                    <label>Mật khẩu hiện tại *</label>

                    <div class="password-input-wrapper">
                        @Html.PasswordFor(
                            model => model.CurrentPassword,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Nhập mật khẩu hiện tại",
                                id = "CurrentPassword"
                            })

                        <button type="button"
                                class="toggle-password"
                                onclick="togglePassword('CurrentPassword', this)">
                            <i class="glyphicon glyphicon-eye-open"></i>
                        </button>
                    </div>

                    @Html.ValidationMessageFor(
                        model => model.CurrentPassword,
                        "",
                        new { @class = "password-error" })
                </div>

                <div class="form-group">
                    <label>Mật khẩu mới *</label>

                    <div class="password-input-wrapper">
                        @Html.PasswordFor(
                            model => model.NewPassword,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Nhập mật khẩu mới",
                                id = "NewPassword"
                            })

                        <button type="button"
                                class="toggle-password"
                                onclick="togglePassword('NewPassword', this)">
                            <i class="glyphicon glyphicon-eye-open"></i>
                        </button>
                    </div>

                    @Html.ValidationMessageFor(
                        model => model.NewPassword,
                        "",
                        new { @class = "password-error" })
                </div>

                <div class="form-group">
                    <label>Xác nhận mật khẩu mới *</label>

                    <div class="password-input-wrapper">
                        @Html.PasswordFor(
                            model => model.ConfirmPassword,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Nhập lại mật khẩu mới",
                                id = "ConfirmPassword"
                            })

                        <button type="button"
                                class="toggle-password"
                                onclick="togglePassword('ConfirmPassword', this)">
                            <i class="glyphicon glyphicon-eye-open"></i>
                        </button>
                    </div>

                    @Html.ValidationMessageFor(
                        model => model.ConfirmPassword,
                        "",
                        new { @class = "password-error" })
                </div>

                <div class="password-actions">
                    <button type="submit" class="btn-password-save">
                        <i class="glyphicon glyphicon-floppy-disk"></i>
                        Đổi mật khẩu
                    </button>

                    <a href="@Url.Action("Profile", "Account")"
                       class="btn-password-cancel">
                        Quay lại
                    </a>
                </div>
            }

            <div class="password-note">
                <strong>Lưu ý:</strong>
                Mật khẩu mới phải có ít nhất 8 ký tự.
                Không sử dụng mật khẩu dễ đoán hoặc chia sẻ mật khẩu
                với người khác.
            </div>

        </div>
    </div>
</div>

<script>
    function togglePassword(inputId, button) {

        var input = document.getElementById(inputId);
        var icon = button.querySelector("i");

        if (input.type === "password") {
            input.type = "text";
            icon.className = "glyphicon glyphicon-eye-close";
        }
        else {
            input.type = "password";
            icon.className = "glyphicon glyphicon-eye-open";
        }
    }
</script>
