@{
    ViewBag.Title = "Đăng nhập - Gear Sport";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link href="@Url.Content("~/Content/login.css")"
          rel="stylesheet" />
</head>
<body>
    <main class="login-page">

        <!-- BÊN TRÁI: HÌNH ẢNH VÀ THƯƠNG HIỆU -->
        <section class="hero-panel">

            <a href="@Url.Content("~/")" class="brand brand-light">
                <span>GEAR</span><strong>SPORT</strong>
            </a>

            <div class="hero-content">
                <div class="hero-tag">
                    <span></span> YOUR SPORT. YOUR STYLE.
                </div>

                <h1>
                    BẮT ĐẦU HÀNH TRÌNH
                    <span>VƯỢT GIỚI HẠN</span>
                </h1>

                <p>
                    Gear Sport đồng hành cùng bạn trên mọi hành trình.
                    Khám phá trang phục thể thao chất lượng và tự tin
                    chinh phục mục tiêu của chính mình.
                </p>

                <div class="hero-features">
                    <div class="feature-item">
                        <i class="fa-solid fa-truck-fast"></i>
                        <span>Giao hàng<br />nhanh chóng</span>
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Sản phẩm<br />chất lượng</span>
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-headset"></i>
                        <span>Hỗ trợ<br />tận tâm</span>
                    </div>
                </div>
            </div>

            <div class="hero-footer">
                GEAR SPORT <span></span> MORE THAN SPORTS
            </div>
        </section>

        <!-- BÊN PHẢI: FORM ĐĂNG NHẬP -->
        <section class="form-panel">

            <nav class="top-nav">
                <a href="@Url.Content("~/")">
                    <i class="fa-solid fa-house"></i>
                    Trang chủ
                </a>
                <span class="nav-divider"></span>
                <a href="@Url.Content("~/")">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Cửa hàng
                </a>
            </nav>

            <div class="login-card">

                <a href="@Url.Content("~/")"
                   class="brand brand-dark">
                    <span>GEAR</span><strong>SPORT</strong>
                </a>

                <h2>Đăng nhập tài khoản</h2>

                <p class="login-description">
                    Chào mừng bạn trở lại! Đăng nhập để tiếp tục
                    mua sắm và khám phá những ưu đãi hấp dẫn.
                </p>

                <form id="loginForm">

                    <div class="form-group">
                        <label for="email">Email hoặc số điện thoại</label>

                        <div class="input-wrapper">
                            <i class="fa-regular fa-envelope input-icon"></i>

                            <input type="text"
                                   id="email"
                                   name="email"
                                   placeholder="Nhập email hoặc số điện thoại"
                                   autocomplete="username"
                                   required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Mật khẩu</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-lock input-icon"></i>

                            <input type="password"
                                   id="password"
                                   name="password"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password"
                                   required />

                            <button type="button"
                                    class="toggle-password"
                                    id="togglePassword"
                                    aria-label="Hiện mật khẩu">
                                <i class="fa-regular fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="remember-option">
                            <input type="checkbox" id="rememberMe" />
                            <span class="custom-checkbox">
                                <i class="fa-solid fa-check"></i>
                            </span>
                            <span>Ghi nhớ đăng nhập</span>
                        </label>

                        <a href="#" id="forgotPassword">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit" class="login-button">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        ĐĂNG NHẬP
                    </button>

                    <div id="loginMessage"
                         class="demo-message"
                         role="status"
                         aria-live="polite"
                         hidden>
                    </div>

                    <div class="social-divider">
                        <span></span>
                        <p>Hoặc đăng nhập với</p>
                        <span></span>
                    </div>

                    <div class="social-buttons">
                        <button type="button"
                                class="social-button google-button"
                                id="googleLogin"
                                aria-label="Đăng nhập bằng Google">
                            <i class="fa-brands fa-google"></i>
                        </button>

                        <button type="button"
                                class="social-button facebook-button"
                                id="facebookLogin"
                                aria-label="Đăng nhập bằng Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </button>
                    </div>

                    <p class="register-text">
                        Chưa có tài khoản?
                        <a href="#" id="registerLink">Đăng ký ngay</a>
                    </p>

                </form>

                <a href="@Url.Content("~/")" class="back-home">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại trang chủ
                </a>

            </div>
        </section>
    </main>

    <script>
        // Hiện hoặc ẩn mật khẩu
        const passwordInput = document.getElementById("password");
        const togglePassword = document.getElementById("togglePassword");

        togglePassword.addEventListener("click", function () {
            const isPassword = passwordInput.type === "password";

            passwordInput.type = isPassword ? "text" : "password";

            this.innerHTML = isPassword
                ? '<i class="fa-regular fa-eye"></i>'
                : '<i class="fa-regular fa-eye-slash"></i>';

            this.setAttribute(
                "aria-label",
                isPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu"
            );
        });

        // Demo giao diện: không gửi dữ liệu đến máy chủ
        const loginForm = document.getElementById("loginForm");
        const loginMessage = document.getElementById("loginMessage");

        function showDemoMessage(message) {
            loginMessage.textContent = message;
            loginMessage.hidden = false;
        }

        loginForm.addEventListener("submit", function (event) {
            event.preventDefault();

            showDemoMessage(
                "Đây là giao diện Frontend demo. Chức năng đăng nhập chưa được kết nối."
            );
        });

        // Các liên kết minh họa vì chưa có chức năng tương ứng
        document.getElementById("forgotPassword")
            .addEventListener("click", function (event) {
                event.preventDefault();
                showDemoMessage("Chức năng quên mật khẩu chưa được triển khai.");
            });

        document.getElementById("registerLink")
            .addEventListener("click", function (event) {
                event.preventDefault();
                showDemoMessage("Trang đăng ký tài khoản chưa được triển khai.");
            });

        document.getElementById("googleLogin")
            .addEventListener("click", function () {
                showDemoMessage("Đăng nhập Google chưa được kết nối.");
            });

        document.getElementById("facebookLogin")
            .addEventListener("click", function () {
                showDemoMessage("Đăng nhập Facebook chưa được kết nối.");
            });
    </script>
</body>
</html>