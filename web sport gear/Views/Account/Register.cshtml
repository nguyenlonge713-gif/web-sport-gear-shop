
@{
    ViewBag.Title = "Đăng ký - Gear Sport";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link href="@Url.Content("~/Content/login.css")"
          rel="stylesheet" />

    <style>
        .register-card {
            width: 100%;
            max-width: 480px;
            margin: 0 auto;
        }

            .register-card .register-description {
                color: #777;
                line-height: 1.6;
                margin-bottom: 24px;
            }

            .register-card .form-group {
                margin-bottom: 16px;
            }

            .register-card .input-wrapper {
                position: relative;
            }

                .register-card .input-wrapper input {
                    width: 100%;
                    box-sizing: border-box;
                    padding-right: 45px;
                }

            .register-card .toggle-password {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                cursor: pointer;
                color: #777;
            }

            .register-card .register-button {
                width: 100%;
                margin-top: 8px;
                cursor: pointer;
            }

            .register-card .register-message {
                margin-top: 14px;
                font-size: 14px;
                line-height: 1.5;
            }

                .register-card .register-message.error {
                    color: #d93025;
                }

                .register-card .register-message.success {
                    color: #188038;
                }

            .register-card .validation-summary-errors {
                color: #d93025;
                margin-bottom: 15px;
            }

                .register-card .validation-summary-errors ul {
                    padding-left: 20px;
                }

            .register-card .phone-validation {
                display: block;
                color: #d93025;
                font-size: 13px;
                margin-top: 6px;
                line-height: 1.5;
            }

            .register-card .field-validation-error {
                display: block;
                color: #d93025;
                font-size: 13px;
                margin-top: 6px;
            }

            .register-card .input-hint {
                display: block;
                color: #777;
                font-size: 12px;
                margin-top: 7px;
                line-height: 1.6;
            }

            .register-card .password-rules {
                list-style: none;
                padding: 0;
                margin: 8px 0 0;
                font-size: 12px;
                line-height: 1.8;
                color: #777;
            }

                .register-card .password-rules li {
                    display: flex;
                    align-items: center;
                    gap: 7px;
                }

                    .register-card .password-rules li.valid {
                        color: #188038;
                    }

                    .register-card .password-rules li.invalid {
                        color: #d93025;
                    }

                .register-card .password-rules i {
                    width: 13px;
                }

            .register-card .login-text {
                text-align: center;
                margin-top: 22px;
            }

                .register-card .login-text a {
                    font-weight: 600;
                }

        @@media (max-width: 768px) {
            .register-card {
                padding-top: 20px;
                padding-bottom: 20px;
            }
        }
    </style>
</head>

<body>
    <main class="login-page">

        <!-- BÊN TRÁI: THƯƠNG HIỆU -->
        <section class="hero-panel">

            <a href="@Url.Content("~/")" class="brand brand-light">
                <span>GEAR</span><strong>SPORT</strong>
            </a>

            <div class="hero-content">
                <div class="hero-tag">
                    <span></span> YOUR SPORT. YOUR STYLE.
                </div>

                <h1>
                    GIA NHẬP CỘNG ĐỒNG
                    <span>GEAR SPORT</span>
                </h1>

                <p>
                    Tạo tài khoản để khám phá các sản phẩm thể thao,
                    theo dõi đơn hàng và trải nghiệm mua sắm thuận tiện
                    cùng Gear Sport.
                </p>

                <div class="hero-features">
                    <div class="feature-item">
                        <i class="fa-solid fa-basket-shopping"></i>
                        <span>Mua sắm<br />dễ dàng</span>
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-box"></i>
                        <span>Theo dõi<br />đơn hàng</span>
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Tài khoản<br />an toàn</span>
                    </div>
                </div>
            </div>

            <div class="hero-footer">
                GEAR SPORT <span></span> MORE THAN SPORTS
            </div>
        </section>

        <!-- BÊN PHẢI: FORM ĐĂNG KÝ -->
        <section class="form-panel">

            <nav class="top-nav">
                <a href="@Url.Content("~/")">
                    <i class="fa-solid fa-house"></i>
                    Trang chủ
                </a>

                <span class="nav-divider"></span>

                <a href="@Url.Content("~/")">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Cửa hàng
                </a>
            </nav>

            <div class="login-card register-card">

                <a href="@Url.Content("~/")"
                   class="brand brand-dark">
                    <span>GEAR</span><strong>SPORT</strong>
                </a>

                <h2>Tạo tài khoản</h2>

                <p class="register-description">
                    Điền thông tin bên dưới để bắt đầu mua sắm
                    cùng Gear Sport.
                </p>

                @using (Html.BeginForm(
                    "Register",
                    "Account",
                    FormMethod.Post,
                    new { id = "registerForm" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                             false,
                             "",
                             new { @class = "validation-summary-errors" })

                    <!-- HỌ VÀ TÊN -->
                    <div class="form-group">
                        <label for="FullName">Họ và tên</label>

                        <div class="input-wrapper">
                            <i class="fa-regular fa-user input-icon"></i>

                            <input type="text"
                                   id="FullName"
                                   name="FullName"
                                   value="@Request.Form["FullName"]"
                                   placeholder="Nhập họ và tên"
                                   minlength="2"
                                   maxlength="100"
                                   pattern="[A-Za-zÀ-ỹĐđ]+([ '-][A-Za-zÀ-ỹĐđ]+)*"
                                   title="Họ và tên chỉ được chứa chữ cái, tối thiểu 2 ký tự , tối đa 100 ký tự , dấu cách hoặc dấu gạch nối."
                                   autocomplete="name"
                                   required />
                        </div>
                    </div>

                    <!-- EMAIL -->
                    <div class="form-group">
                        <label for="Email">Email</label>

                        <div class="input-wrapper">
                            <i class="fa-regular fa-envelope input-icon"></i>

                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   value="@Request.Form["Email"]"
                                   placeholder="example@email.com"
                                   maxlength="255"
                                   autocomplete="email"
                                   required />
                        </div>
                    </div>

                    <!-- SỐ ĐIỆN THOẠI -->
                    <div class="form-group">
                        <label for="Phone">Số điện thoại</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-phone input-icon"></i>

                            <input type="tel"
                                   id="Phone"
                                   name="Phone"
                                   value="@Request.Form["Phone"]"
                                   placeholder="Nhập số điện thoại"
                                   minlength="10"
                                   maxlength="10"
                                   pattern="[0-9]{10}"
                                   inputmode="numeric"
                                   autocomplete="tel"
                                   required />
                        </div>

                        <small class="input-hint">
                            Số điện thoại phải gồm chính xác 10 chữ số.
                        </small>

                        @Html.ValidationMessage(
                                 "Phone",
                                 "",
                                 new { @class = "phone-validation" })
                    </div>

                    <!-- MẬT KHẨU -->
                    <div class="form-group">
                        <label for="Password">Mật khẩu</label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-lock input-icon"></i>

                            <input type="password"
                                   id="Password"
                                   name="Password"
                                   placeholder="Nhập mật khẩu"
                                   minlength="8"
                                   maxlength="128"
                                   autocomplete="new-password"
                                   required />

                            <button type="button"
                                    class="toggle-password"
                                    data-target="Password"
                                    aria-label="Hiện mật khẩu">
                                <i class="fa-regular fa-eye-slash"></i>
                            </button>
                        </div>

                        <small class="input-hint">
                            Mật khẩu phải có từ 8 đến 128 ký tự và đáp ứng đủ các điều kiện:
                        </small>

                        <ul class="password-rules">
                            <li id="rule-length" class="invalid">
                                <i class="fa-solid fa-circle-xmark"></i>
                                Từ 8 đến 128 ký tự
                            </li>

                            <li id="rule-uppercase" class="invalid">
                                <i class="fa-solid fa-circle-xmark"></i>
                                Ít nhất một chữ cái viết hoa (A-Z)
                            </li>

                            <li id="rule-number" class="invalid">
                                <i class="fa-solid fa-circle-xmark"></i>
                                Ít nhất một chữ số (0-9)
                            </li>

                            <li id="rule-special" class="invalid">
                                <i class="fa-solid fa-circle-xmark"></i>
                                Ít nhất một ký tự đặc biệt
                            </li>
                        </ul>
                    </div>

                    <!-- XÁC NHẬN MẬT KHẨU -->
                    <div class="form-group">
                        <label for="ConfirmPassword">
                            Xác nhận mật khẩu
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-lock input-icon"></i>

                            <input type="password"
                                   id="ConfirmPassword"
                                   name="ConfirmPassword"
                                   placeholder="Nhập lại mật khẩu"
                                   minlength="8"
                                   maxlength="128"
                                   autocomplete="new-password"
                                   required />

                            <button type="button"
                                    class="toggle-password"
                                    data-target="ConfirmPassword"
                                    aria-label="Hiện mật khẩu">
                                <i class="fa-regular fa-eye-slash"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit"
                            class="login-button register-button">
                        <i class="fa-solid fa-user-plus"></i>
                        ĐĂNG KÝ
                    </button>

                    <div id="registerMessage"
                         class="register-message"
                         role="status"
                         aria-live="polite"
                         hidden>
                    </div>
                }

                <p class="login-text">
                    Đã có tài khoản?
                    <a href="@Url.Action("Login", "Account")">
                        Đăng nhập ngay
                    </a>
                </p>

                <a href="@Url.Content("~/")" class="back-home">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại trang chủ
                </a>

            </div>
        </section>
    </main>

    <script>
        // Hiện hoặc ẩn mật khẩu.
        document.querySelectorAll(".toggle-password")
            .forEach(function (button) {
                button.addEventListener("click", function () {
                    const input = document.getElementById(
                        this.getAttribute("data-target")
                    );

                    const showPassword = input.type === "password";

                    input.type = showPassword ? "text" : "password";

                    this.innerHTML = showPassword
                        ? '<i class="fa-regular fa-eye"></i>'
                        : '<i class="fa-regular fa-eye-slash"></i>';

                    this.setAttribute(
                        "aria-label",
                        showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu"
                    );
                });
            });

        // Lấy các phần tử của biểu mẫu.
        const registerForm = document.getElementById("registerForm");

        const fullNameInput = document.getElementById("FullName");
        const emailInput = document.getElementById("Email");
        const phoneInput = document.getElementById("Phone");
        const passwordInput = document.getElementById("Password");
        const confirmInput = document.getElementById("ConfirmPassword");

        // Cập nhật trạng thái từng điều kiện mật khẩu.
        function updatePasswordRule(elementId, valid) {
            const element = document.getElementById(elementId);

            element.classList.toggle("valid", valid);
            element.classList.toggle("invalid", !valid);

            element.querySelector("i").className = valid
                ? "fa-solid fa-circle-check"
                : "fa-solid fa-circle-xmark";
        }

        // Kiểm tra mật khẩu.
        function checkPassword() {
            const password = passwordInput.value;

            const validLength =
                password.length >= 8 && password.length <= 128;

            const hasUppercase = /[A-Z]/.test(password);

            const hasNumber = /[0-9]/.test(password);

            const hasSpecialChar =
                /[^A-Za-z0-9\s]/.test(password);

            updatePasswordRule("rule-length", validLength);
            updatePasswordRule("rule-uppercase", hasUppercase);
            updatePasswordRule("rule-number", hasNumber);
            updatePasswordRule("rule-special", hasSpecialChar);

            if (!validLength) {
                passwordInput.setCustomValidity(
                    "Mật khẩu phải có từ 8 đến 128 ký tự."
                );
            } else if (!hasUppercase) {
                passwordInput.setCustomValidity(
                    "Mật khẩu phải có ít nhất một chữ cái viết hoa."
                );
            } else if (!hasNumber) {
                passwordInput.setCustomValidity(
                    "Mật khẩu phải có ít nhất một chữ số."
                );
            } else if (!hasSpecialChar) {
                passwordInput.setCustomValidity(
                    "Mật khẩu phải có ít nhất một ký tự đặc biệt."
                );
            } else {
                passwordInput.setCustomValidity("");
            }
        }

        // Kiểm tra hai mật khẩu có trùng nhau không.
        function checkPasswordMatch() {
            if (confirmInput.value === "") {
                confirmInput.setCustomValidity("");
                return;
            }

            if (passwordInput.value !== confirmInput.value) {
                confirmInput.setCustomValidity(
                    "Mật khẩu xác nhận không khớp."
                );
            } else {
                confirmInput.setCustomValidity("");
            }
        }

        // Kiểm tra lại khi người dùng nhập mật khẩu.
        passwordInput.addEventListener("input", function () {
            checkPassword();
            checkPasswordMatch();
        });

        confirmInput.addEventListener("input", checkPasswordMatch);

        // Khi sửa mật khẩu chính, kiểm tra lại mật khẩu xác nhận.
        passwordInput.addEventListener("change", checkPasswordMatch);

        // Kiểm tra dữ liệu trước khi gửi biểu mẫu.
        registerForm.addEventListener("submit", function (event) {
            checkPassword();
            checkPasswordMatch();

            if (!registerForm.checkValidity()) {
                event.preventDefault();
                registerForm.reportValidity();
                return;
            }
        });
    </script>
</body>
</html>
