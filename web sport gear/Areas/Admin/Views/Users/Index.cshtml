
@model List<web_sport_gear.Models.AdminUserViewModel>

@{
    ViewBag.Title = "Quản lý tài khoản";
    string currentKeyword = ViewBag.Keyword as string ?? "";
}

<style>
    .users-page {
        padding: 30px;
        color: #263445;
    }

    .users-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .users-title {
        margin: 0;
        font-size: 27px;
        font-weight: 700;
        color: #20334d;
    }

    .users-subtitle {
        margin-top: 7px;
        color: #7b8797;
        font-size: 14px;
    }

    .users-total {
        background: #eef4ff;
        color: #315b9b;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
    }

    .users-filter-card {
        background: #fff;
        padding: 20px;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(25, 45, 75, 0.06);
        margin-bottom: 22px;
    }

    .users-filter-form {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .users-search-input {
        height: 42px;
        border: 1px solid #dce3ed;
        border-radius: 8px;
        padding: 0 13px;
        outline: none;
        color: #34445a;
        background: #fff;
        font-size: 14px;
        flex: 1;
        min-width: 220px;
    }

        .users-search-input:focus {
            border-color: #477ed0;
            box-shadow: 0 0 0 3px rgba(71, 126, 208, 0.1);
        }

    .users-btn {
        border: none;
        border-radius: 8px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

    .users-btn-search {
        background: #315f9f;
        color: #fff;
    }

        .users-btn-search:hover {
            background: #244b80;
            color: #fff;
        }

    .users-btn-reset {
        background: #edf0f5;
        color: #536176;
    }

        .users-btn-reset:hover {
            background: #dfe5ee;
            color: #263445;
            text-decoration: none;
        }

    .users-table-card {
        background: #fff;
        border-radius: 13px;
        box-shadow: 0 4px 18px rgba(25, 45, 75, 0.06);
        overflow: hidden;
    }

    .users-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
        margin: 0;
    }

        .users-table thead {
            background: #f5f7fb;
        }

        .users-table th {
            padding: 16px 14px;
            color: #536176;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            white-space: nowrap;
            border-bottom: 1px solid #e8edf4;
        }

        .users-table td {
            padding: 16px 14px;
            border-bottom: 1px solid #edf0f5;
            vertical-align: middle;
            font-size: 13px;
            color: #46566c;
        }

        .users-table tbody tr:hover {
            background: #fafcff;
        }

    .user-id {
        font-weight: 700;
        color: #75849a;
    }

    .user-name {
        color: #263e60;
        font-weight: 600;
    }

    .user-email {
        color: #46566c;
        word-break: break-word;
    }

    .user-phone {
        color: #65758b;
    }

    .role-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
        background: #e8f2ff;
        color: #3268a8;
    }

    .user-date {
        white-space: nowrap;
        color: #7b8797;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        background: #e5f7ed;
        color: #218653;
    }

    .status-inactive {
        background: #fff0f0;
        color: #c34444;
    }

    .users-empty {
        text-align: center;
        padding: 45px 15px !important;
        color: #8793a4 !important;
    }

        .users-empty i {
            display: block;
            font-size: 30px;
            margin-bottom: 10px;
            color: #b4bfce;
        }

    .readonly-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 7px;
        background: #f0f4f8;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    @@media (max-width: 768px) {
        .users-page {
            padding: 18px 12px;
        }

        .users-title {
            font-size: 22px;
        }

        .users-filter-form {
            align-items: stretch;
        }

            .users-search-input,
            .users-filter-form .users-btn {
                width: 100%;
            }
    }
</style>

<div class="users-page">

    <!-- HEADER -->
    <div class="users-header">
        <div>
            <h2 class="users-title">
                <i class="fa fa-users"></i>
                Quản lý tài khoản
            </h2>

            <div class="users-subtitle">
                Chỉ xem thông tin tài khoản khách hàng. Không có quyền chỉnh sửa.
            </div>
        </div>

        <div class="users-total">
            <i class="fa fa-user-circle"></i>
            Tổng số: @(Model == null ? 0 : Model.Count) khách hàng
        </div>
    </div>

    <!-- TIM KIEM -->
    <div class="users-filter-card">
        @using (Html.BeginForm(
            "Index",
            "Users",
            new { area = "Admin" },
            FormMethod.Get,
            new { @class = "users-filter-form" }))
        {
            @Html.TextBox(
                     "keyword",
                     currentKeyword,
                     new
                     {
                         @class = "users-search-input",
                         placeholder = "Tìm theo họ tên, email hoặc số điện thoại..."
                     }
                 )

            <button type="submit" class="users-btn users-btn-search">
                <i class="fa fa-search"></i>
                Tìm kiếm
            </button>

            <a href="@Url.Action("Index", "Users", new { area = "Admin" })"
               class="users-btn users-btn-reset">
                <i class="fa fa-refresh"></i>
                Làm mới
            </a>
        }
    </div>

    <!-- DANH SACH CUSTOMER -->
    <div class="users-table-card">
        <div class="users-table-wrapper">
            <table class="users-table">
                <thead>
                    <tr>
                        <th>Mã tài khoản</th>
                        <th>Họ và tên</th>
                        <th>Email đăng nhập</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th>Quyền thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <span class="user-id">
                                        #@user.UserID
                                    </span>
                                </td>

                                <td>
                                    <span class="user-name">
                                        @(string.IsNullOrWhiteSpace(user.FullName)
                                            ? "Chưa cập nhật"
                                            : user.FullName)
                                    </span>
                                </td>

                                <td>
                                    <span class="user-email">
                                        @(string.IsNullOrWhiteSpace(user.Email)
                                            ? "Chưa cập nhật"
                                            : user.Email)
                                    </span>
                                </td>

                                <td>
                                    <span class="user-phone">
                                        @(string.IsNullOrWhiteSpace(user.Phone)
                                            ? "Chưa cập nhật"
                                            : user.Phone)
                                    </span>
                                </td>

                                <td>
                                    <span class="role-badge">
                                        <i class="fa fa-user"></i>
                                        Customer
                                    </span>
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fa fa-check-circle"></i>
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="fa fa-times-circle"></i>
                                            Vô hiệu hóa
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="user-date">
                                        @(user.CreatedAt == DateTime.MinValue
                                            ? "-"
                                            : user.CreatedAt.ToString("dd/MM/yyyy"))
                                    </span>
                                </td>

                                <td>
                                    <span class="readonly-label">
                                        <i class="fa fa-eye"></i>
                                        Chỉ xem
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="users-empty">
                                <i class="fa fa-search"></i>
                                Không tìm thấy tài khoản khách hàng phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
