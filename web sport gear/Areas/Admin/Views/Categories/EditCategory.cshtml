
@model web_sport_gear.Models.Category

@{
    ViewBag.Title = "Sửa danh mục";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>SỬA DANH MỤC</h2>

    <hr />

    @using (Html.BeginForm("EditCategory", "Categories",
        new { area = "Admin" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.CategoryID)

        <div class="form-group">
            @Html.LabelFor(m => m.CategoryID, "Mã danh mục")

            @Html.TextBoxFor(m => m.CategoryID, new
            {
                @class = "form-control",
                @readonly = "readonly"
            })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CategoryName, "Tên danh mục")

            @Html.TextBoxFor(m => m.CategoryName, new
 {
     @class = "form-control",
     placeholder = "Nhập tên danh mục...",
     maxlength = "100",
     autocomplete = "off"
 })

            @Html.ValidationMessageFor(
                   m => m.CategoryName,
                   "",
                   new { @class = "text-danger" }
               )

            <small class="text-muted">
                Tên danh mục không được để trống và tối đa 100 ký tự.
            </small>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="glyphicon glyphicon-save"></i>
            Lưu thay đổi
        </button>

        <a href="@Url.Action("CategoryList", "Categories",
            new { area = "Admin" })"
           class="btn btn-default">
            Hủy
        </a>
    }
</div>
